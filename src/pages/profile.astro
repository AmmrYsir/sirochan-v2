---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/common/Button.astro';
import { db } from '../db/client';
import { users } from '../db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const dbUser = await db.query.users.findFirst({
  where: eq(users.id, user.id)
});

const profile = {
  id: user.id,
  username: dbUser?.username || user.username || 'User',
  handle: dbUser?.handle || `@${(dbUser?.username || user.username || 'user').toLowerCase()}`,
  avatar: dbUser?.avatar || `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(user.id)}`,
  chaptersRead: dbUser?.chaptersRead || 0,
  hoursWatched: dbUser?.hoursWatched || 0,
  readingStreakDays: dbUser?.readingStreakDays || 1,
  preferredReaderMode: dbUser?.preferredReaderMode || 'continuous',
  preferredStreamQuality: dbUser?.preferredStreamQuality || '1080p'
};
---

<MainLayout title="Profile - Sirochan" activeTab="profile">
  <div class="profile-page container-constrained">
    <!-- User Header Banner Card -->
    <div class="user-header-card">
      <img src={profile.avatar} alt={profile.username} class="avatar" />
      <div class="user-info">
        <div class="name-row">
          <h1 class="user-name">{profile.username}</h1>
          <span class="member-badge">PRO MEMBER</span>
        </div>
        <p class="user-handle">{profile.handle}</p>
        <p class="user-bio">Manga enthusiast & Anime streaming connoisseur on Sirochan v2.</p>
      </div>
    </div>

    <!-- Multi-Column Grid for Desktop -->
    <div class="profile-grid">
      <!-- Left Column: Stats & Reading Streak -->
      <div class="profile-column">
        <h2 class="section-heading">ACTIVITY & STATS</h2>
        <div class="stats-grid">
          <div class="stat-box">
            <span class="stat-value">{profile.chaptersRead}</span>
            <span class="stat-label">Chapters Read</span>
          </div>
          <div class="stat-box">
            <span class="stat-value">{profile.hoursWatched}h</span>
            <span class="stat-label">Hours Watched</span>
          </div>
          <div class="stat-box highlight">
            <span class="stat-value">{profile.readingStreakDays} 🔥</span>
            <span class="stat-label">Day Streak</span>
          </div>
        </div>

        <div class="streak-banner">
          <div class="streak-icon">⚡</div>
          <div class="streak-text">
            <span class="streak-title">Daily Streak Active!</span>
            <span class="streak-sub">Read 1 chapter or watch 1 episode today to keep your streak alive.</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Settings & App Preferences -->
      <div class="profile-column">
        <h2 class="section-heading">APP PREFERENCES</h2>
        <div class="settings-group">
          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-name">Default Reader Mode</span>
              <span class="setting-desc">Single Page vs Continuous Scroll</span>
            </div>
            <select class="setting-select" id="pref-reader-mode">
              <option value="continuous" selected={profile.preferredReaderMode === 'continuous'}>Continuous Scroll</option>
              <option value="single" selected={profile.preferredReaderMode === 'single'}>Single Page</option>
            </select>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-name">Anime Stream Quality</span>
              <span class="setting-desc">Preferred streaming resolution</span>
            </div>
            <select class="setting-select" id="pref-stream-quality">
              <option value="1080p" selected={profile.preferredStreamQuality === '1080p'}>1080p Full HD</option>
              <option value="720p" selected={profile.preferredStreamQuality === '720p'}>720p HD</option>
              <option value="auto">Auto Adaptive</option>
            </select>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-name">Dark Mode Theme</span>
              <span class="setting-desc">Modern Japanese Editorial Theme</span>
            </div>
            <span class="meta-tag">DARK FIRST (ACTIVE)</span>
          </div>
        </div>

        <div class="action-footer">
          <Button id="logout-btn" variant="secondary" size="lg" class="w-full">LOG OUT</Button>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      } catch (e) {
        window.location.href = '/login';
      }
    });
  }
</script>

<style>
  .profile-page {
    padding-top: 24px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .user-header-card {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 28px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .avatar {
    width: 88px;
    height: 88px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 3px solid var(--accent-red);
    box-shadow: 0 4px 16px rgba(230, 57, 70, 0.25);
  }

  .user-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .name-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .user-name {
    font-family: var(--font-hero);
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .user-handle {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .user-bio {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .member-badge {
    padding: 3px 10px;
    border-radius: var(--radius-full);
    background-color: rgba(244, 162, 97, 0.15);
    color: var(--accent-orange);
    border: 1px solid var(--accent-orange);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  /* Multi-Column Layout Grid for Desktop */
  .profile-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 1024px) {
    .profile-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .profile-column {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .section-heading {
    font-family: var(--font-hero);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 8px;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px 12px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .stat-box.highlight {
    border-color: var(--accent-orange);
    background-color: rgba(244, 162, 97, 0.06);
  }

  .stat-value {
    font-family: var(--font-hero);
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .streak-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .streak-icon {
    font-size: 1.8rem;
  }

  .streak-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .streak-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: #ffffff;
  }

  .streak-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Settings Group */
  .settings-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .setting-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .setting-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
  }

  .setting-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .setting-select {
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: #ffffff;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.85rem;
    outline: none;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-red);
    font-weight: 700;
  }

  .w-full {
    width: 100%;
  }

  .action-footer {
    margin-top: 8px;
  }
</style>
