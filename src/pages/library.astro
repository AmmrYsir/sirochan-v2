---
import MainLayout from '../layouts/MainLayout.astro';
import MangaCard from '../components/media/MangaCard.astro';
import AnimeCard from '../components/media/AnimeCard.astro';
import { ApiService } from '../db/apiService';
import { MANGA_PLACEHOLDER, ANIME_PLACEHOLDER } from '../utils/placeholders';
import { cacheThumbnailLocally } from '../utils/thumbnailCache';
import { db } from '../db/client';
import { bookmarks, userProgress, media } from '../db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;

let bookmarkedMedia: any[] = [];
let continueMedia: any[] = [];

if (user) {
  try {
    // 1. Fetch real DB bookmarks for user
    const dbBookmarks = await db.query.bookmarks.findMany({
      where: eq(bookmarks.userId, user.id),
      orderBy: [desc(bookmarks.createdAt)]
    });

    // 2. Fetch real DB progress for user
    const dbProgress = await db.query.userProgress.findMany({
      where: eq(userProgress.userId, user.id),
      orderBy: [desc(userProgress.lastReadOrWatchedAt)]
    });

    const mediaIds = [...new Set([...dbBookmarks.map(b => b.mediaId), ...dbProgress.map(p => p.mediaId)])];
    
    // Fetch cached media entries from DB
    const mediaEntries = mediaIds.length > 0
      ? await db.query.media.findMany({
          where: (table, { inArray }) => inArray(table.id, mediaIds)
        })
      : [];

    const mediaMap = new Map(mediaEntries.map(m => [m.id, m]));

    // Map real bookmarked items
    bookmarkedMedia = await Promise.all(dbBookmarks.map(async b => {
      const cached = mediaMap.get(b.mediaId);
      const srcId = cached?.sourceId || (b.mediaId.includes(':') ? b.mediaId.split(':')[0] : 'mangadex');
      const titleId = cached?.sourceTitleId || (b.mediaId.includes(':') ? b.mediaId.split(':')[1] : b.mediaId);

      let liveDetails: any = null;
      if (srcId && titleId) {
        liveDetails = await ApiService.getTitleDetails(srcId, titleId);
      }

      const title = cached?.title || liveDetails?.title || titleId || 'Saved Media';
      const isAnime = (cached?.type || liveDetails?.mediaType) === 'anime';

      const hasValidCachedCover = cached?.coverImage && !cached.coverImage.startsWith('data:');
      let finalCover = (hasValidCachedCover ? cached.coverImage : null) || liveDetails?.thumbnailUrl || (isAnime ? ANIME_PLACEHOLDER : MANGA_PLACEHOLDER);

      if (!hasValidCachedCover && liveDetails?.thumbnailUrl) {
        const localPath = await cacheThumbnailLocally(b.mediaId, liveDetails.thumbnailUrl);
        if (localPath) {
          finalCover = localPath;
          await db.update(media).set({ coverImage: localPath }).where(eq(media.id, b.mediaId));
        }
      }

      return {
        id: titleId,
        sourceId: srcId,
        sourceTitleId: titleId,
        title,
        type: isAnime ? 'anime' : 'manga',
        coverImage: finalCover,
        bannerImage: cached?.bannerImage || liveDetails?.thumbnailUrl || ANIME_PLACEHOLDER,
        description: cached?.description || liveDetails?.description || 'Bookmarked in library.',
        rating: cached?.rating || liveDetails?.rating || 4.9,
        status: 'RELEASING' as const,
        genres: cached?.genres || liveDetails?.tags || [isAnime ? 'Anime' : 'Manga'],
        latestChapterOrEpisode: isAnime ? `EP. ${liveDetails?.totalEpisodes || 12}` : `CH. ${liveDetails?.totalChapters || 100}`,
        updatedAgo: 'BOOKMARKED'
      };
    }));

    // Map real continue progress items
    continueMedia = await Promise.all(dbProgress.map(async p => {
      const cached = mediaMap.get(p.mediaId);
      const srcId = cached?.sourceId || (p.mediaId.includes(':') ? p.mediaId.split(':')[0] : 'mangadex');
      const titleId = cached?.sourceTitleId || (p.mediaId.includes(':') ? p.mediaId.split(':')[1] : p.mediaId);

      let liveDetails: any = null;
      if (srcId && titleId) {
        liveDetails = await ApiService.getTitleDetails(srcId, titleId);
      }

      const title = cached?.title || liveDetails?.title || titleId || 'In Progress';
      const isAnime = p.contentType === 'episode' || (cached?.type || liveDetails?.mediaType) === 'anime';

      const hasValidCachedCover = cached?.coverImage && !cached.coverImage.startsWith('data:');
      let finalCover = (hasValidCachedCover ? cached.coverImage : null) || liveDetails?.thumbnailUrl || (isAnime ? ANIME_PLACEHOLDER : MANGA_PLACEHOLDER);

      if (!hasValidCachedCover && liveDetails?.thumbnailUrl) {
        const localPath = await cacheThumbnailLocally(p.mediaId, liveDetails.thumbnailUrl);
        if (localPath) {
          finalCover = localPath;
          await db.update(media).set({ coverImage: localPath }).where(eq(media.id, p.mediaId));
        }
      }

      return {
        id: titleId,
        sourceId: srcId,
        sourceTitleId: titleId,
        title,
        type: isAnime ? 'anime' : 'manga',
        coverImage: finalCover,
        bannerImage: cached?.bannerImage || liveDetails?.thumbnailUrl || ANIME_PLACEHOLDER,
        description: cached?.description || liveDetails?.description || 'In progress media.',
        rating: cached?.rating || liveDetails?.rating || 4.9,
        status: 'RELEASING' as const,
        genres: cached?.genres || liveDetails?.tags || [isAnime ? 'Anime' : 'Manga'],
        latestChapterOrEpisode: isAnime ? `EP. ${p.contentNumber}` : `CH. ${p.contentNumber}`,
        updatedAgo: 'PROGRESS',
        progressPercent: p.progressPercent || 50
      };
    }));

  } catch (err) {
    console.error('[Library] Error fetching user bookmarks from DB:', err);
  }
}

// Fallback if no user or empty DB bookmarks
if (bookmarkedMedia.length === 0 && continueMedia.length === 0) {
  try {
    const sources = await ApiService.getSources();
    const browseResults = await Promise.all(
      sources.slice(0, 3).map(src => ApiService.browseSource(src.id))
    );

    const allItems = browseResults.flatMap((res, idx) => {
      const srcId = sources[idx]?.id || 'mangadex';
      return res.items.map(item => ({
        ...item,
        sourceId: srcId
      }));
    });

    const fallbackList = allItems.map(item => {
      const isAnime = item.mediaType === 'anime';
      return {
        id: item.sourceTitleId,
        sourceId: item.sourceId,
        sourceTitleId: item.sourceTitleId,
        title: item.title,
        type: item.mediaType,
        coverImage: item.thumbnailUrl || (isAnime ? ANIME_PLACEHOLDER : MANGA_PLACEHOLDER),
        bannerImage: item.thumbnailUrl,
        description: item.description || 'Discovered library title.',
        rating: item.rating || 4.8,
        status: 'RELEASING' as const,
        genres: item.genres && item.genres.length > 0 ? item.genres : [isAnime ? 'Anime' : 'Manga'],
        latestChapterOrEpisode: isAnime ? `EP. ${item.totalEpisodes || 12}` : `CH. ${item.totalChapters || 100}`,
        updatedAgo: 'DISCOVER'
      };
    });

    continueMedia = fallbackList.slice(0, 4);
    bookmarkedMedia = fallbackList.slice(4, 10);
  } catch (err) {
    console.error('[Library] Error fetching fallback media:', err);
  }
}
---

<MainLayout title="My Library - Sirochan" activeTab="library">
  <div class="library-page container-constrained">
    <div class="library-header">
      <div class="header-title-row">
        <h1 class="page-title">MY LIBRARY</h1>
        <span class="privacy-badge">🔒 PRIVACY PROTECTED</span>
      </div>
      
      <div class="lib-tabs">
        <button class="lib-tab active" data-tab="all">All Titles ({continueMedia.length + bookmarkedMedia.length})</button>
        <button class="lib-tab" data-tab="in-progress">In Progress ({continueMedia.length})</button>
        <button class="lib-tab" data-tab="bookmarks">Bookmarked ({bookmarkedMedia.length})</button>
        <button class="lib-tab" data-tab="favorites">Favorites</button>
      </div>
    </div>

    <!-- Continue / In Progress Section -->
    <section class="lib-section" id="sec-in-progress">
      <div class="section-title-wrapper">
        <h2 class="section-subtitle">CONTINUE READING & WATCHING</h2>
        <span class="count-tag">{continueMedia.length} Active</span>
      </div>
      
      {continueMedia.length > 0 ? (
        <div class="responsive-media-grid">
          {continueMedia.map(item => (
            item.type === 'manga' ? (
              <MangaCard item={item} />
            ) : (
              <AnimeCard item={item} />
            )
          ))}
        </div>
      ) : (
        <div class="empty-state-box">
          <p>No active progress records yet. Start reading manga or streaming anime from Discover.</p>
          <a href="/discover" class="btn-primary">BROWSE DISCOVER →</a>
        </div>
      )}
    </section>

    <!-- Bookmarks Section -->
    <section class="lib-section" id="sec-bookmarks">
      <div class="section-title-wrapper">
        <h2 class="section-subtitle">BOOKMARKED TITLES</h2>
        <span class="count-tag">{bookmarkedMedia.length} Saved</span>
      </div>

      {bookmarkedMedia.length > 0 ? (
        <div class="responsive-media-grid">
          {bookmarkedMedia.map(item => (
            item.type === 'manga' ? (
              <MangaCard item={item} />
            ) : (
              <AnimeCard item={item} />
            )
          ))}
        </div>
      ) : (
        <div class="empty-state-box">
          <p>Your library is empty. Click "ADD TO BOOKMARKS" on any manga or anime to save it here.</p>
          <a href="/discover" class="btn-primary">EXPLORE SOURCES →</a>
        </div>
      )}
    </section>
  </div>
</MainLayout>

<script>
  const libTabs = document.querySelectorAll('.lib-tab');
  const secInProgress = document.getElementById('sec-in-progress');
  const secBookmarks = document.getElementById('sec-bookmarks');

  libTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      libTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const targetTab = tab.getAttribute('data-tab');

      if (targetTab === 'in-progress') {
        if (secInProgress) secInProgress.style.display = 'flex';
        if (secBookmarks) secBookmarks.style.display = 'none';
      } else if (targetTab === 'bookmarks') {
        if (secInProgress) secInProgress.style.display = 'none';
        if (secBookmarks) secBookmarks.style.display = 'flex';
      } else {
        if (secInProgress) secInProgress.style.display = 'flex';
        if (secBookmarks) secBookmarks.style.display = 'flex';
      }
    });
  });
</script>

<style>
  .library-page {
    padding-top: 24px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .header-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }

  .page-title {
    font-family: var(--font-hero);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .privacy-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #2ec4b6;
    background-color: rgba(46, 196, 182, 0.12);
    border: 1px solid #2ec4b6;
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .lib-tabs {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 12px;
    overflow-x: auto;
  }

  .lib-tab {
    padding: 8px 16px;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .lib-tab:hover {
    color: #ffffff;
    background-color: var(--bg-surface);
  }

  .lib-tab.active {
    background-color: var(--bg-elevated);
    color: #ffffff;
    border: 1px solid var(--border-subtle);
  }

  .lib-section {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .section-title-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-subtitle {
    font-family: var(--font-hero);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.03em;
  }

  .count-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .empty-state-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 40px 20px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .empty-state-box p {
    font-size: 0.92rem;
    color: var(--text-muted);
    max-width: 440px;
  }

  .btn-primary {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-red);
    text-decoration: none;
    letter-spacing: 0.03em;
  }
</style>
