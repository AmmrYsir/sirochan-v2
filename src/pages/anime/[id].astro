---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/common/Button.astro';
import Badge from '../../components/common/Badge.astro';
import { mockMediaList } from '../../db/mockData';

export function getStaticPaths() {
  return mockMediaList
    .filter(m => m.type === 'anime')
    .map(item => ({ params: { id: item.id } }));
}

const { id } = Astro.params;
const item = mockMediaList.find(m => m.id === id) || mockMediaList[3];
const episodes = item.episodes || Array.from({ length: 12 }, (_, i) => ({
  id: `${item.id}-ep-${i + 1}`,
  mediaId: item.id,
  episodeNumber: i + 1,
  seasonNumber: 1,
  title: `Episode ${i + 1}: The Unfolding Destiny`,
  duration: '23:10',
  timeMarker: '00:00',
  videoUrl: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/TearsOfSteel.mp4',
  thumbnail: item.coverImage
}));
---

<MainLayout title={`${item.title} - Anime Stream on Sirochan`}>
  <div class="anime-detail-page">
    <!-- Banner Header -->
    <div class="detail-banner-wrapper">
      <img src={item.bannerImage} alt={item.title} class="detail-banner" />
      <div class="banner-overlay"></div>
    </div>

    <div class="detail-content container-constrained">
      <div class="detail-grid">
        <!-- Cover & Actions -->
        <div class="cover-column">
          <img src={item.coverImage} alt={item.title} class="main-cover" />
          <Button href={`/anime/${item.id}/${episodes[0].id}`} variant="primary" size="lg" class="watch-btn">
            STREAM EPISODE 1
          </Button>
        </div>

        <!-- Meta & Overview -->
        <div class="info-column">
          <Badge variant="red" class="status-badge">{item.status}</Badge>
          <h1 class="anime-title">{item.title}</h1>
          <p class="jp-title">{item.japaneseTitle}</p>

          <div class="meta-row">
            <span class="rating-badge">★ {item.rating}</span>
            <span class="meta-dot">•</span>
            <span class="meta-mono">{episodes.length} EPISODES</span>
          </div>

          <div class="genre-tags">
            {item.genres.map(g => (
              <span class="genre-pill">{g}</span>
            ))}
          </div>

          <p class="description">{item.description}</p>
        </div>
      </div>

      <!-- Episode List Grid -->
      <section class="episodes-section">
        <h2 class="section-title">EPISODES ({episodes.length})</h2>
        <div class="episodes-grid">
          {episodes.map(ep => (
            <a href={`/anime/${item.id}/${ep.id}`} class="ep-card">
              <div class="ep-thumb-wrapper">
                <img src={ep.thumbnail} alt={ep.title} class="ep-thumb" />
                <span class="ep-duration">{ep.duration}</span>
              </div>
              <div class="ep-info">
                <span class="ep-num">EP. {ep.episodeNumber}</span>
                <h3 class="ep-title">{ep.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</MainLayout>

<style>
  .detail-banner-wrapper {
    position: relative;
    width: 100%;
    height: 260px;
    overflow: hidden;
  }

  .detail-banner {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, var(--bg-deep) 100%);
  }

  .detail-content {
    margin-top: -80px;
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .detail-grid {
      grid-template-columns: 240px 1fr;
    }
  }

  .cover-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .main-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    object-fit: cover;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
  }

  .watch-btn {
    width: 100%;
  }

  .info-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .anime-title {
    font-family: var(--font-hero);
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .jp-title {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .rating-badge {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-orange);
    font-size: 0.9rem;
  }

  .meta-dot {
    color: var(--text-dim);
  }

  .meta-mono {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .genre-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .genre-pill {
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-top: 8px;
  }

  .episodes-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .ep-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px;
    transition: all 0.2s ease;
  }

  .ep-card:hover {
    border-color: var(--text-muted);
    background-color: var(--bg-elevated);
  }

  .ep-thumb-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .ep-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ep-duration {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background-color: rgba(0,0,0,0.8);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #ffffff;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .ep-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ep-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-red);
  }

  .ep-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
