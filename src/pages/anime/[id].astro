---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/common/Button.astro';
import Badge from '../../components/common/Badge.astro';
import { ApiService } from '../../db/apiService';

export async function getStaticPaths() {
  try {
    const sources = await ApiService.getSources();
    const livePaths: Array<{ params: { id: string } }> = [];
    for (const src of sources) {
      if (src.type === 'anime' || src.type === 'dual') {
        const res = await ApiService.browseSource(src.id);
        for (const item of res.items) {
          const safeId = (item.sourceTitleId || 'title').replace(/[\/\s]/g, '-').toLowerCase();
          livePaths.push({ params: { id: safeId } });
        }
      }
    }
    return livePaths;
  } catch {
    return [];
  }
}

function formatHumanDate(dateStr?: string | null): string | null {
  if (
    !dateStr ||
    dateStr.trim() === '' ||
    dateStr === 'JUST NOW' ||
    dateStr === 'CLASSIC' ||
    dateStr === '2026-07-30'
  )
    return null;
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return null;

  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffHours >= 0 && diffHours < 1) return 'Just now';
  if (diffHours >= 1 && diffHours < 24) return `${diffHours}h ago`;
  if (diffDays >= 1 && diffDays < 7) return `${diffDays}d ago`;
  if (diffDays >= 7 && diffDays < 30)
    return `${Math.floor(diffDays / 7)}w ago`;

  return d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

const { id } = Astro.params;

// Resolve real microservice data for this title!
let liveTitleDetails = null;

if (id) {
  const sources = await ApiService.getSources();
  for (const src of sources) {
    if (src.type === 'anime' || src.type === 'dual') {
      const details = await ApiService.getTitleDetails(src.id, id);
      if (details) {
        if (!liveTitleDetails || details.thumbnailUrl || details.description) {
          liveTitleDetails = details;
          if (details.thumbnailUrl && details.description) {
            break;
          }
        }
      }
    }
  }
}

const rawDesc = liveTitleDetails?.description
  ? liveTitleDetails.description.replace(/<[^>]*>/g, '').replace(/&[a-z0-9#]+;/gi, '"')
  : '';

const rawDate = liveTitleDetails?.updatedAt || liveTitleDetails?.releasedAt || null;
const humanDate = formatHumanDate(rawDate);

const item = liveTitleDetails ? {
  id: liveTitleDetails.sourceTitleId,
  title: liveTitleDetails.title,
  japaneseTitle: liveTitleDetails.altTitles?.[0] || liveTitleDetails.title,
  type: 'anime' as const,
  coverImage: liveTitleDetails.thumbnailUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80',
  bannerImage: liveTitleDetails.thumbnailUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80',
  description: rawDesc || 'Live metadata title details fetched directly from microservice adapter.',
  rating: liveTitleDetails.rating || 4.8,
  status: (liveTitleDetails.status?.toUpperCase() || 'RELEASING') as any,
  genres: liveTitleDetails.tags?.length > 0 ? liveTitleDetails.tags : ['Action', 'Fantasy'],
  latestChapterOrEpisode: `EP. ${liveTitleDetails.totalEpisodes || 1}`,
  humanDate: humanDate
} : {
  id: id || 'title',
  title: id?.replace(/-/g, ' ').toUpperCase() || 'TITLE',
  japaneseTitle: '',
  type: 'anime' as const,
  coverImage: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80',
  bannerImage: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80',
  description: 'Live title details from microservice.',
  rating: 4.8,
  status: 'RELEASING' as const,
  genres: ['Anime'],
  latestChapterOrEpisode: 'EP. 1',
  humanDate: null
};

const count = liveTitleDetails?.totalEpisodes || liveTitleDetails?.contentSummary?.totalCount || 1;
const episodes = Array.from({ length: count }, (_, i) => ({
  id: `${item.id}-ep-${i + 1}`,
  mediaId: item.id,
  episodeNumber: i + 1,
  seasonNumber: 1,
  title: item.title,
  duration: '23:10',
  thumbnail: item.coverImage,
  humanDate: item.humanDate
}));
---

<MainLayout title={`${item.title} - Anime Stream on Sirochan`}>
  <div class="anime-detail-page">
    <!-- Banner Header -->
    <div class="detail-banner-wrapper">
      <img src={item.bannerImage} alt={item.title} class="detail-banner" />
      <div class="banner-overlay"></div>
    </div>

    <div class="detail-content container-constrained">
      <div class="detail-grid">
        <!-- Cover & Actions -->
        <div class="cover-column">
          <img src={item.coverImage} alt={item.title} class="main-cover" />
          <Button href={`/anime/${item.id}/${episodes[0].id}`} variant="primary" size="lg" class="watch-btn">
            STREAM EPISODE 1
          </Button>
        </div>

        <!-- Meta & Overview -->
        <div class="info-column">
          <Badge variant="red" class="status-badge">{item.status}</Badge>
          <h1 class="anime-title">{item.title}</h1>
          <p class="jp-title">{item.japaneseTitle}</p>

          <div class="meta-row">
            <span class="rating-badge">★ {item.rating}</span>
            <span class="meta-dot">•</span>
            <span class="meta-mono">{episodes.length} EPISODES</span>
            {item.humanDate && (
              <>
                <span class="meta-dot">•</span>
                <span class="meta-date">{item.humanDate}</span>
              </>
            )}
          </div>

          <div class="genre-tags">
            {item.genres.map(g => (
              <span class="genre-pill">{g}</span>
            ))}
          </div>

          <p class="description">{item.description}</p>
        </div>
      </div>

      <!-- Episode List Grid -->
      <section class="episodes-section">
        <div class="episodes-header-row">
          <h2 class="section-title">EPISODES ({episodes.length})</h2>
          <div class="sort-segmented-control">
            <span class="sort-icon-label">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
              SORT
            </span>
            <div class="sort-pills-wrapper">
              <button class="sort-pill active" data-sort="latest">
                <span>Latest</span>
                <svg class="sort-arrow-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <button class="sort-pill" data-sort="oldest">
                <span>Oldest</span>
                <svg class="sort-arrow-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="episodes-grid" id="episodes-container">
          {episodes.map(ep => (
            <a href={`/anime/${item.id}/${ep.id}`} class="ep-card" data-num={ep.episodeNumber}>
              <div class="ep-thumb-wrapper">
                <img src={ep.thumbnail} alt={ep.title} class="ep-thumb" />
                <span class="ep-duration">{ep.duration}</span>
              </div>
              <div class="ep-info">
                <div class="ep-num-row">
                  <span class="ep-num">EP. {ep.episodeNumber}</span>
                  {ep.humanDate && <span class="ep-date">{ep.humanDate}</span>}
                </div>
                <h3 class="ep-title">{ep.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</MainLayout>

<script>
  const sortBtns = document.querySelectorAll('.sort-pill');
  const container = document.getElementById('episodes-container');

  if (container) {
    sortBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const sort = btn.getAttribute('data-sort');
        sortBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const cards = Array.from(container.children) as HTMLElement[];
        cards.sort((a, b) => {
          const numA = parseInt(a.getAttribute('data-num') || '0');
          const numB = parseInt(b.getAttribute('data-num') || '0');
          return sort === 'latest' ? numB - numA : numA - numB;
        });

        cards.forEach(card => container.appendChild(card));
      });
    });
  }
</script>

<style>
  .detail-banner-wrapper {
    position: relative;
    width: 100%;
    height: 260px;
    overflow: hidden;
  }

  .detail-banner {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, var(--bg-deep) 100%);
  }

  .detail-content {
    margin-top: -80px;
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .detail-grid {
      grid-template-columns: 240px 1fr;
    }
  }

  .cover-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .main-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    object-fit: cover;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
  }

  .watch-btn {
    width: 100%;
  }

  .info-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .anime-title {
    font-family: var(--font-hero);
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .jp-title {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .rating-badge {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-orange);
    font-size: 0.9rem;
  }

  .meta-dot {
    color: var(--text-dim);
  }

  .meta-mono, .meta-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .genre-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .genre-pill {
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-top: 8px;
  }

  .episodes-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .episodes-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 10px;
  }

  .sort-segmented-control {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(22, 22, 26, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 3px 4px 3px 12px;
  }

  .sort-icon-label {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .sort-pills-wrapper {
    display: flex;
    align-items: center;
    gap: 2px;
    background-color: var(--bg-surface);
    border-radius: var(--radius-full);
    padding: 2px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sort-pill {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sort-pill:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.06);
  }

  .sort-pill.active {
    background-color: var(--accent-red);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(230, 57, 70, 0.4);
  }

  .sort-arrow-icon {
    opacity: 0.7;
    transition: transform 0.2s ease;
  }

  .sort-pill:hover .sort-arrow-icon {
    opacity: 1;
  }

  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .ep-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px;
    transition: all 0.2s ease;
  }

  .ep-card:hover {
    border-color: var(--text-muted);
    background-color: var(--bg-elevated);
  }

  .ep-thumb-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .ep-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ep-duration {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background-color: rgba(0,0,0,0.8);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #ffffff;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .ep-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ep-num-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ep-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-red);
  }

  .ep-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .ep-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
