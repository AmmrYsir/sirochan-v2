---
import MainLayout from '../../../layouts/MainLayout.astro';
import { mockMediaList } from '../../../db/mockData';

export function getStaticPaths() {
  const animeList = mockMediaList.filter(m => m.type === 'anime');
  const paths: Array<{ params: { id: string; episode: string } }> = [];

  for (const item of animeList) {
    const episodes = item.episodes || Array.from({ length: 8 }, (_, i) => ({ id: `sl-ep-${i + 1}` }));
    for (const ep of episodes) {
      paths.push({ params: { id: item.id, episode: ep.id } });
    }
  }
  return paths;
}

const { id, episode } = Astro.params;
const item = mockMediaList.find(m => m.id === id) || mockMediaList[3];

const currentEpNum = episode?.includes('ep-') ? parseInt(episode.split('ep-')[1]) : 11;
const sampleVideoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/TearsOfSteel.mp4';
---

<MainLayout title={`${item.title} - S1 EP. ${currentEpNum}`} hideNav={true}>
  <div class="anime-player-shell">
    <!-- Top Player Header -->
    <header class="player-top-bar">
      <a href={`/anime/${item.id}`} class="back-btn" aria-label="Back">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </a>
      <div class="player-title-group">
        <h1 class="player-title">{item.title}</h1>
        <span class="player-ep-sub">SEASON 1 • EPISODE {currentEpNum}</span>
      </div>
      <div class="quality-picker">
        <span class="quality-badge">1080p HD</span>
      </div>
    </header>

    <!-- Main Video Frame & Overlays -->
    <div class="video-container">
      <video id="anime-video" class="video-element" poster={item.bannerImage} src={sampleVideoUrl} controls={false}>
      </video>

      <!-- Skip Intro Overlay Pill -->
      <button class="skip-intro-btn" id="skip-intro-btn">
        SKIP INTRO (+85s) ⚡
      </button>

      <!-- Custom Video Control Bar -->
      <div class="video-controls-overlay">
        <div class="progress-bar-container" id="progress-container">
          <div class="progress-bar-fill" id="progress-fill" style="width: 55%;"></div>
        </div>

        <div class="controls-row">
          <div class="left-controls">
            <button class="ctrl-btn" id="play-pause-btn" aria-label="Play/Pause">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </button>
            <span class="time-display" id="time-display">12:45 / 23:10</span>
          </div>

          <div class="right-controls">
            <button class="ctrl-btn" id="fullscreen-btn" aria-label="Fullscreen">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Episode Selector Carousel below Video -->
    <div class="player-episodes-section container-constrained">
      <h3 class="section-title">NEXT EPISODES</h3>
      <div class="ep-scroll-row hide-scrollbar">
        {Array.from({ length: 8 }, (_, i) => {
          const epNo = i + 1;
          const isCurrent = epNo === currentEpNum;
          return (
            <a href={`/anime/${item.id}/sl-ep-${epNo}`} class={`ep-pill-card ${isCurrent ? 'active' : ''}`}>
              <span class="ep-tag">EP {epNo}</span>
              <span class="ep-name">Episode {epNo}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const video = document.getElementById('anime-video') as HTMLVideoElement;
  const playBtn = document.getElementById('play-pause-btn');
  const skipBtn = document.getElementById('skip-intro-btn');
  const progressFill = document.getElementById('progress-fill');
  const timeDisplay = document.getElementById('time-display');

  if (video && playBtn) {
    playBtn.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        playBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>`;
      } else {
        video.pause();
        playBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
      }
    });

    video.addEventListener('timeupdate', () => {
      if (video.duration && progressFill && timeDisplay) {
        const pct = (video.currentTime / video.duration) * 100;
        progressFill.style.width = `${pct}%`;

        const curM = Math.floor(video.currentTime / 60);
        const curS = Math.floor(video.currentTime % 60).toString().padStart(2, '0');
        const durM = Math.floor(video.duration / 60);
        const durS = Math.floor(video.duration % 60).toString().padStart(2, '0');
        timeDisplay.textContent = `${curM}:${curS} / ${durM}:${durS}`;
      }
    });

    skipBtn?.addEventListener('click', () => {
      video.currentTime += 85;
    });
  }
</script>

<style>
  .anime-player-shell {
    position: fixed;
    inset: 0;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    z-index: 100;
    overflow-y: auto;
  }

  .player-top-bar {
    height: 60px;
    background-color: rgba(18, 18, 18, 0.95);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    z-index: 20;
  }

  .back-btn {
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
  }

  .player-title-group {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .player-title {
    font-family: var(--font-hero);
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
  }

  .player-ep-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .quality-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-orange);
    border: 1px solid var(--accent-orange);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  /* Video Container */
  .video-container {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    background-color: #000000;
  }

  .video-element {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Skip Intro Overlay */
  .skip-intro-btn {
    position: absolute;
    bottom: 70px;
    right: 20px;
    background-color: rgba(30, 30, 30, 0.9);
    color: #ffffff;
    border: 1px solid var(--border-subtle);
    padding: 8px 16px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .skip-intro-btn:hover {
    background-color: var(--accent-red);
    border-color: var(--accent-red);
  }

  /* Video Controls */
  .video-controls-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0) 100%);
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .progress-bar-container {
    width: 100%;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    overflow: hidden;
    cursor: pointer;
  }

  .progress-bar-fill {
    height: 100%;
    background-color: var(--accent-orange);
  }

  .controls-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .left-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ctrl-btn {
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .time-display {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .player-episodes-section {
    padding-top: 24px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ep-scroll-row {
    display: flex;
    gap: 12px;
    overflow-x: auto;
  }

  .ep-pill-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 16px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    min-width: 120px;
  }

  .ep-pill-card.active {
    border-color: var(--accent-red);
    background-color: var(--bg-elevated);
  }

  .ep-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-red);
  }

  .ep-name {
    font-size: 0.85rem;
    color: var(--text-primary);
  }
</style>
