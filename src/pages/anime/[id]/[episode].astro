---
import MainLayout from '../../../layouts/MainLayout.astro';
import AnimePlayer from '../../../components/player/AnimePlayer.astro';
import { ApiService } from '../../../db/apiService';

export async function getStaticPaths() {
  const paths: Array<{ params: { id: string; episode: string } }> = [];

  try {
    const sources = await ApiService.getSources();
    for (const src of sources) {
      if (src.type === 'anime' || src.type === 'dual') {
        const res = await ApiService.browseSource(src.id);
        for (const item of res.items) {
          const safeId = (item.sourceTitleId || 'title').replace(/[\/\s]/g, '-').toLowerCase();
          paths.push({ params: { id: safeId, episode: `${safeId}-ep-1` } });
        }
      }
    }
  } catch {
    // fallback
  }

  return paths;
}

const { id, episode } = Astro.params;

// Resolve real live playback stream from http://localhost:8000 microservice!
let realPlaybackData = null;

if (id) {
  const sources = await ApiService.getSources();
  for (const src of sources) {
    if (src.type === 'anime' || src.type === 'dual') {
      const playback = await ApiService.getPlaybackStream(src.id, id, episode);
      if (playback && playback.streamUrl) {
        realPlaybackData = playback;
        break;
      }
    }
  }
}

const item = {
  id: id || 'title',
  title: realPlaybackData?.title || id?.replace(/-/g, ' ').toUpperCase() || 'ANIME STREAM',
  type: 'anime' as const
};

const currentEpNum = episode?.includes('ep-') ? parseInt(episode.split('ep-')[1]) : 1;
const videoUrl = realPlaybackData?.streamUrl || '';
const posterUrl = realPlaybackData?.posterUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80';
---

<MainLayout title={`${item.title} - S1 EP.${currentEpNum}`} hideNav={true}>
  <AnimePlayer
    animeTitle={item.title}
    episodeNumber={currentEpNum}
    seasonNumber={1}
    episodeTitle={realPlaybackData?.title || "Episode Stream"}
    videoUrl={videoUrl}
    posterUrl={posterUrl}
    animeId={item.id}
  />
</MainLayout>
