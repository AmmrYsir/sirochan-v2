---
import MainLayout from '../../../layouts/MainLayout.astro';
import AnimePlayer from '../../../components/player/AnimePlayer.astro';
import { ApiService } from '../../../db/apiService';


const { id, episode } = Astro.params;

const epNum = episode?.includes('-ep-') ? episode.split('-ep-').pop() : (episode?.includes('ep-') ? episode.split('ep-').pop() : '1');
const candidates: (string | undefined)[] = Array.from(new Set([
  episode,
  epNum,
  epNum ? `ep-${epNum}` : undefined,
  epNum ? `episode-${epNum}` : undefined,
  undefined
]));

let realPlaybackData: any = null;

if (id) {
  const sources = await ApiService.getSources();
  for (const src of sources) {
    if (src.type === 'anime' || src.type === 'dual') {
      const targetTitleIds = [id];
      const catalog = await ApiService.browseSource(src.id);
      const match = catalog.items.find(item => {
        const safe = (item.sourceTitleId || 'title').replace(/[\/\s]/g, '-').toLowerCase();
        return safe === id || item.sourceTitleId === id || safe.includes(id) || id.includes(safe);
      });

      if (match && match.sourceTitleId && !targetTitleIds.includes(match.sourceTitleId)) {
        targetTitleIds.push(match.sourceTitleId);
      }

      for (const titleId of targetTitleIds) {
        for (const cand of candidates) {
          const res = await ApiService.getPlaybackStream(src.id, titleId, cand);
          if (res && res.streamUrl) {
            realPlaybackData = res;
            break;
          }
        }
        if (realPlaybackData) break;
      }

      if (realPlaybackData) break;
    }
  }
}

const item = {
  id: id || 'title',
  title: realPlaybackData?.title || id?.replace(/-/g, ' ').toUpperCase() || 'ANIME STREAM',
  type: 'anime' as const
};

const currentEpNum = episode?.includes('ep-') ? parseInt(episode.split('ep-')[1]) : 1;
const videoUrl = realPlaybackData?.streamUrl || '';
const posterUrl = realPlaybackData?.posterUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80';
---

<MainLayout title={`${item.title} - S1 EP.${currentEpNum}`} hideNav={true}>
  <AnimePlayer
    animeTitle={item.title}
    episodeNumber={currentEpNum}
    seasonNumber={1}
    episodeTitle={realPlaybackData?.title || "Episode Stream"}
    videoUrl={videoUrl}
    posterUrl={posterUrl}
    animeId={item.id}
  />
</MainLayout>
