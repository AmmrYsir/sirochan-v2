---
import MainLayout from '../../../layouts/MainLayout.astro';
import MangaReader from '../../../components/reader/MangaReader.astro';
import AnimePlayer from '../../../components/player/AnimePlayer.astro';
import { ApiService } from '../../../db/apiService';
import { ANIME_PLACEHOLDER } from '../../../utils/placeholders';


const { sourceId = 'mangadex', id = 'title', chapter = 'ch-1' } = Astro.params;

const VIDEO_SOURCES = ['spankbang', 'xvideos', 'xhamster', 'rule34world'];

// 1. Fetch title details or find matching catalog item
let liveTitleDetails = await ApiService.getTitleDetails(sourceId, id);
let actualSourceTitleId = id;

if (!liveTitleDetails) {
  const catalog = await ApiService.browseSource(sourceId);
  const match = catalog.items.find(item => {
    const safe = (item.sourceTitleId || 'title').replace(/[\/\s]/g, '-').toLowerCase();
    return safe === id || item.sourceTitleId === id || safe.includes(id) || id.includes(safe);
  });
  if (match) {
    actualSourceTitleId = match.sourceTitleId;
    liveTitleDetails = await ApiService.getTitleDetails(sourceId, match.sourceTitleId);
  }
}

const isVideo = VIDEO_SOURCES.includes(sourceId.toLowerCase()) || liveTitleDetails?.mediaType === 'anime';

let videoPlaybackData: any = null;
let realPagesData: any = null;

if (isVideo) {
  // Fetch video stream details from microservice
  videoPlaybackData = await ApiService.getPlaybackStream(sourceId, actualSourceTitleId);
} else {
  // Fetch manga reader pages
  const chNum = chapter.includes('-ch-') ? chapter.split('-ch-').pop() : (chapter.includes('ch-') ? chapter.split('ch-').pop() : '1');
  const candidates: (string | undefined)[] = Array.from(new Set([
    chapter,
    chNum,
    chNum ? `ch-${chNum}` : undefined,
    chNum ? `chapter-${chNum}` : undefined,
    undefined
  ]));

  const targetTitleIds = [actualSourceTitleId];
  if (id !== actualSourceTitleId) targetTitleIds.push(id);

  for (const titleId of targetTitleIds) {
    for (const cand of candidates) {
      const res = await ApiService.getReaderPages(sourceId, titleId, cand);
      if (res && res.pages && res.pages.length > 0) {
        realPagesData = res;
        break;
      }
    }
    if (realPagesData) break;
  }
}

const title = videoPlaybackData?.title || liveTitleDetails?.title || id.replace(/-/g, ' ').toUpperCase();
const streamUrl = videoPlaybackData?.streamUrl || '';
const posterUrl = videoPlaybackData?.posterUrl || liveTitleDetails?.thumbnailUrl || ANIME_PLACEHOLDER;

const pageUrls = realPagesData && realPagesData.pages.length > 0
  ? realPagesData.pages.map((p: any) => p.imageUrl)
  : [];

const currentChNum = chapter.includes('ch-') ? parseInt(chapter.split('ch-')[1]) || 1 : 1;
---

{isVideo ? (
  <MainLayout title={`${title} - Video Player`} hideNav={true}>
    <AnimePlayer
      animeTitle={title}
      episodeNumber={currentChNum}
      episodeTitle="Full Stream HD"
      videoUrl={streamUrl}
      posterUrl={posterUrl}
      animeId={actualSourceTitleId}
      episodes={[{ id: chapter, number: 1, title: title, duration: 'HD Stream' }]}
    />
  </MainLayout>
) : (
  <MainLayout title={`${title} - Manga Reader`} hideNav={true}>
    <MangaReader
      mangaTitle={title}
      chapterTitle={`Chapter ${currentChNum}`}
      chapterNumber={currentChNum}
      totalPages={pageUrls.length}
      pages={pageUrls}
      mangaId={actualSourceTitleId}
    />
  </MainLayout>
)}
