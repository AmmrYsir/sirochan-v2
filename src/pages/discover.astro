---
import MainLayout from '../layouts/MainLayout.astro';
import MangaCard from '../components/media/MangaCard.astro';
import AnimeCard from '../components/media/AnimeCard.astro';
import Badge from '../components/common/Badge.astro';
import { ApiService } from '../db/apiService';

const sources = await ApiService.getSources();
const liveFeed = await ApiService.unifiedFeed('all');

const mediaList = liveFeed.items.map(item => {
  const safeId = (item.sourceTitleId || 'title').replace(/[\/\s]/g, '-').toLowerCase();
  return {
    id: safeId,
    title: item.title,
    type: item.mediaType,
    coverImage: item.thumbnailUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80',
    bannerImage: item.thumbnailUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80',
    description: item.description || 'Live title.',
    rating: item.rating || 4.8,
    status: 'RELEASING' as const,
    genres: ['Action', 'Fantasy'],
    latestChapterOrEpisode: item.mediaType === 'manga' ? `CH. ${item.totalChapters || 100}` : `EP. ${item.totalEpisodes || 12}`,
    updatedAgo: 'JUST NOW'
  };
});

const genres = ['All', 'Action', 'Dark Fantasy', 'Sports', 'Drama', 'Sci-Fi', 'Supernatural'];
---

<MainLayout title="Discover Sources - Sirochan" activeTab="discover">
  <div class="discover-page container-constrained">
    <!-- Header Title -->
    <div class="discover-masthead">
      <h1 class="page-title">DISCOVER & SOURCES</h1>
      <p class="page-subtitle">Select your content provider source to explore manga chapters and anime streams.</p>
    </div>

    <!-- Source Selection View (Default Active Mode) -->
    <section class="sources-section" id="sources-view">
      <div class="section-top-bar">
        <h2 class="section-title">CHOOSE PROVIDER SOURCE FIRST</h2>
        <div class="source-type-filter">
          <button class="source-tab active" data-source-type="all">All ({sources.length})</button>
          <button class="source-tab" data-source-type="manga">Manga Providers</button>
          <button class="source-tab" data-source-type="anime">Anime Providers</button>
        </div>
      </div>

      <!-- Sources Grid -->
      <div class="sources-grid">
        {sources.map((src) => (
          <a href={`/sources/${src.id}`} class="source-card" data-id={src.id} data-name={src.name} data-type={src.type}>
            <div class="source-card-header">
              <div class="source-brand">
                <span class="source-icon">
                  {src.icon && (src.icon.startsWith('http') || src.icon.startsWith('/')) ? (
                    <img src={src.icon} alt={src.name} class="source-img-icon" onerror="this.style.display='none';" />
                  ) : (
                    <span>{src.icon || '⚡'}</span>
                  )}
                </span>
                <div class="source-titles">
                  <h3 class="source-name">{src.name}</h3>
                  <span class="source-meta">{src.itemCount} TITLES • {src.language}</span>
                </div>
              </div>
              <Badge variant={src.type === 'manga' ? 'red' : 'orange'}>{src.type}</Badge>
            </div>

            <p class="source-desc">{src.description}</p>

            <div class="source-card-footer">
              <span class="status-ping">
                <span class="ping-dot"></span> {src.status} ({src.pingMs}ms)
              </span>
              <span class="select-source-btn">
                SELECT SOURCE →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Active Source Browser Workspace (Revealed on Source Select) -->
    <section class="active-source-workspace hidden" id="workspace-view">
      <!-- Active Source Status Header Bar -->
      <div class="active-source-bar">
        <div class="active-source-info">
          <span class="active-label">ACTIVE PROVIDER:</span>
          <span class="active-name" id="active-source-name">MangaDex</span>
          <Badge variant="red" id="active-source-type">MANGA</Badge>
        </div>
        <button class="change-source-btn" id="change-source-btn">
          🔄 SWITCH SOURCE
        </button>
      </div>

      <!-- Source Search & Filters -->
      <div class="source-search-group">
        <div class="search-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" placeholder="Search within selected source..." class="search-input" id="source-search-input" />
        </div>

        <div class="genre-row hide-scrollbar">
          {genres.map((g, idx) => (
            <button class={`genre-chip ${idx === 0 ? 'active' : ''}`}>{g}</button>
          ))}
        </div>
      </div>

      <!-- Media Grid from Selected Source -->
      <div class="media-grid" id="source-media-grid">
        {mediaList.map(item => (
          item.type === 'manga' ? (
            <MangaCard item={item} />
          ) : (
            <AnimeCard item={item} />
          )
        ))}
      </div>
    </section>
  </div>
</MainLayout>

<script>
  // DOM Elements
  const sourcesView = document.getElementById('sources-view');
  const workspaceView = document.getElementById('workspace-view');
  const selectBtns = document.querySelectorAll('.select-source-btn');
  const changeBtn = document.getElementById('change-source-btn');
  const activeNameEl = document.getElementById('active-source-name');
  const activeTypeEl = document.getElementById('active-source-type');
  const sourceTabs = document.querySelectorAll('.source-tab');
  const sourceCards = document.querySelectorAll('.source-card');
  const searchInput = document.getElementById('source-search-input') as HTMLInputElement;
  const genreChips = document.querySelectorAll('.genre-chip');
  const mediaCards = document.querySelectorAll('.manga-card, .anime-card');

  let currentSourceType = 'manga';

  // Source Selection logic
  selectBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const srcId = btn.getAttribute('data-src-id') || 'mangadex';
      const srcName = btn.getAttribute('data-src-name') || 'MangaDex';
      const cardEl = btn.closest('.source-card');
      const srcType = cardEl?.getAttribute('data-type') || 'manga';

      currentSourceType = srcType;

      if (activeNameEl) activeNameEl.textContent = srcName;
      if (activeTypeEl) activeTypeEl.textContent = srcType.toUpperCase();

      // Show workspace & hide selection
      sourcesView?.classList.add('hidden');
      workspaceView?.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      filterMediaCards('');
    });
  });

  // Switch back to source selection
  changeBtn?.addEventListener('click', () => {
    workspaceView?.classList.add('hidden');
    sourcesView?.classList.remove('hidden');
  });

  // Source Type Filter Tabs (Manga vs Anime providers)
  sourceTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      sourceTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const filterType = tab.getAttribute('data-source-type');
      sourceCards.forEach(card => {
        const cType = card.getAttribute('data-type');
        if (filterType === 'all' || cType === filterType) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Media Grid filtering inside active source
  function filterMediaCards(query: string, genre: string = 'All') {
    mediaCards.forEach(card => {
      const cType = card.getAttribute('data-type') || '';
      const cTitle = card.getAttribute('data-title') || '';
      const cGenres = card.getAttribute('data-genres') || '';

      const matchesType = cType === currentSourceType;
      const matchesSearch = !query || cTitle.includes(query.toLowerCase());
      const matchesGenre = genre === 'All' || cGenres.includes(genre.toLowerCase());

      if (matchesType && matchesSearch && matchesGenre) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  searchInput?.addEventListener('input', (e) => {
    filterMediaCards((e.target as HTMLInputElement).value);
  });

  genreChips.forEach(chip => {
    chip.addEventListener('click', () => {
      genreChips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      filterMediaCards(searchInput?.value || '', chip.textContent?.trim() || 'All');
    });
  });
</script>

<style>
  .discover-page {
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .discover-masthead {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .page-title {
    font-family: var(--font-hero);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .page-subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Sources View Header */
  .section-top-bar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 16px;
  }

  @media (min-width: 640px) {
    .section-top-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .source-type-filter {
    display: flex;
    gap: 8px;
  }

  .source-tab {
    padding: 6px 14px;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    background-color: var(--bg-surface);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .source-tab.active {
    background-color: var(--accent-red);
    color: #ffffff;
    border-color: var(--accent-red);
  }

  /* Sources Grid */
  .sources-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .sources-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .sources-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .source-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 20px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    transition: all 0.2s ease;
  }

  .source-card:hover {
    border-color: var(--text-muted);
    background-color: var(--bg-elevated);
    transform: translateY(-2px);
  }

  .source-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .source-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .source-icon {
    font-size: 1.8rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .source-img-icon {
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .source-titles {
    display: flex;
    flex-direction: column;
  }

  .source-name {
    font-family: var(--font-hero);
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
  }

  .source-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .source-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .source-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }

  .status-ping {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .ping-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: #2ec4b6;
    display: inline-block;
  }

  .select-source-btn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-red);
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .select-source-btn:hover {
    color: #ffffff;
  }

  /* Active Workspace View */
  .active-source-workspace {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .active-source-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--accent-red);
    border-radius: var(--radius-lg);
  }

  .active-source-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .active-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .active-name {
    font-family: var(--font-hero);
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
  }

  .change-source-btn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: #ffffff;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 6px 14px;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .change-source-btn:hover {
    background-color: var(--accent-red);
    border-color: var(--accent-red);
  }

  .source-search-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .search-box {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  .search-input {
    width: 100%;
    height: 48px;
    padding-left: 48px;
    padding-right: 16px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
  }

  .search-input:focus {
    border-color: #ffffff;
  }

  .genre-row {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .genre-chip {
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
    background-color: var(--bg-elevated);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
  }

  .genre-chip.active {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
    font-weight: 700;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 20px 16px;
  }

  @media (min-width: 640px) {
    .media-grid {
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 24px 20px;
    }
  }

  .hidden {
    display: none !important;
  }
</style>
