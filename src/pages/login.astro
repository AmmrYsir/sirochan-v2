---
import MainLayout from '../layouts/MainLayout.astro';

const user = Astro.locals.user;

// Redirect logged in user to homepage or profile
if (user) {
  return Astro.redirect('/profile');
}
---

<MainLayout title="Sign In & Register - Sirochan" activeTab="profile" hideNav={false}>
  <div class="auth-page-container">
    <div class="auth-card">
      <!-- Card Header -->
      <div class="auth-card-header">
        <div class="brand-badge">
          <span class="badge-dot"></span>
          <span class="badge-text">SIROCHAN EDITORIAL AUTH</span>
        </div>
        <h1 class="auth-title">WELCOME BACK</h1>
        <p class="auth-subtitle">Sign in to sync your manga reading and anime watch history across devices.</p>
      </div>

      <!-- Tab Switcher -->
      <div class="auth-tab-row">
        <button id="tab-login" class="auth-tab active" type="button">
          SIGN IN
        </button>
        <button id="tab-register" class="auth-tab" type="button">
          REGISTER
        </button>
      </div>

      <!-- Error Alert Message -->
      <div id="auth-error-alert" class="auth-alert" style="display: none;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span id="auth-error-text">Authentication error occurred</span>
      </div>

      <!-- LOGIN FORM -->
      <form id="login-form" class="auth-form">
        <div class="form-group">
          <label for="login-email" class="form-label">EMAIL ADDRESS</label>
          <input 
            type="email" 
            id="login-email" 
            name="email" 
            class="form-input" 
            placeholder="arata@sirochan.app" 
            required 
          />
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="login-password" class="form-label">PASSWORD</label>
            <a href="#" class="forgot-link">FORGOT?</a>
          </div>
          <input 
            type="password" 
            id="login-password" 
            name="password" 
            class="form-input" 
            placeholder="••••••••••••" 
            required 
          />
        </div>

        <button type="submit" id="login-submit-btn" class="btn-primary">
          <span class="btn-text">SIGN IN</span>
          <span class="btn-spinner" style="display: none;">LOADING...</span>
        </button>
      </form>

      <!-- REGISTER FORM -->
      <form id="register-form" class="auth-form" style="display: none;">
        <div class="form-group">
          <label for="register-name" class="form-label">DISPLAY NAME</label>
          <input 
            type="text" 
            id="register-name" 
            name="name" 
            class="form-input" 
            placeholder="Arata Kasuga" 
            required 
          />
        </div>

        <div class="form-group">
          <label for="register-email" class="form-label">EMAIL ADDRESS</label>
          <input 
            type="email" 
            id="register-email" 
            name="email" 
            class="form-input" 
            placeholder="arata@sirochan.app" 
            required 
          />
        </div>

        <div class="form-group">
          <label for="register-password" class="form-label">PASSWORD</label>
          <input 
            type="password" 
            id="register-password" 
            name="password" 
            class="form-input" 
            placeholder="Min 8 chars with 1 uppercase & 1 number" 
            required 
          />
        </div>

        <button type="submit" id="register-submit-btn" class="btn-primary">
          <span class="btn-text">CREATE ACCOUNT</span>
          <span class="btn-spinner" style="display: none;">CREATING...</span>
        </button>
      </form>

      <!-- Footer Info -->
      <div class="auth-card-footer">
        <p class="terms-notice">
          By continuing, you agree to Sirochan's Editorial Terms of Service and Privacy Policy.
        </p>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabLogin = document.getElementById('tab-login');
    const tabRegister = document.getElementById('tab-register');
    const loginForm = document.getElementById('login-form') as HTMLFormElement;
    const registerForm = document.getElementById('register-form') as HTMLFormElement;
    const errorAlert = document.getElementById('auth-error-alert');
    const errorText = document.getElementById('auth-error-text');

    function showError(msg: string) {
      if (errorAlert && errorText) {
        errorText.textContent = msg;
        errorAlert.style.display = 'flex';
      }
    }

    function hideError() {
      if (errorAlert) {
        errorAlert.style.display = 'none';
      }
    }

    // Switch Tabs
    tabLogin?.addEventListener('click', () => {
      tabLogin.classList.add('active');
      tabRegister?.classList.remove('active');
      loginForm.style.display = 'flex';
      registerForm.style.display = 'none';
      hideError();
    });

    tabRegister?.addEventListener('click', () => {
      tabRegister.classList.add('active');
      tabLogin?.classList.remove('active');
      registerForm.style.display = 'flex';
      loginForm.style.display = 'none';
      hideError();
    });

    // Handle Login Submit
    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();

      const btn = document.getElementById('login-submit-btn') as HTMLButtonElement;
      const btnText = btn?.querySelector('.btn-text') as HTMLElement;
      const btnSpinner = btn?.querySelector('.btn-spinner') as HTMLElement;

      const email = (document.getElementById('login-email') as HTMLInputElement).value;
      const password = (document.getElementById('login-password') as HTMLInputElement).value;

      if (btnText && btnSpinner) {
        btnText.style.display = 'none';
        btnSpinner.style.display = 'inline';
        btn.disabled = true;
      }

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });

        const data = await res.json();
        if (!res.ok) {
          showError(data.error || 'Login failed. Please check credentials.');
        } else {
          window.location.href = '/';
        }
      } catch (err: any) {
        showError('Network error connecting to Auth service.');
      } finally {
        if (btnText && btnSpinner) {
          btnText.style.display = 'inline';
          btnSpinner.style.display = 'none';
          btn.disabled = false;
        }
      }
    });

    // Handle Register Submit
    registerForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();

      const btn = document.getElementById('register-submit-btn') as HTMLButtonElement;
      const btnText = btn?.querySelector('.btn-text') as HTMLElement;
      const btnSpinner = btn?.querySelector('.btn-spinner') as HTMLElement;

      const name = (document.getElementById('register-name') as HTMLInputElement).value;
      const email = (document.getElementById('register-email') as HTMLInputElement).value;
      const password = (document.getElementById('register-password') as HTMLInputElement).value;

      if (btnText && btnSpinner) {
        btnText.style.display = 'none';
        btnSpinner.style.display = 'inline';
        btn.disabled = true;
      }

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, password })
        });

        const data = await res.json();
        if (!res.ok) {
          showError(data.error || 'Registration failed.');
        } else {
          window.location.href = '/';
        }
      } catch (err: any) {
        showError('Network error connecting to Auth service.');
      } finally {
        if (btnText && btnSpinner) {
          btnText.style.display = 'inline';
          btnSpinner.style.display = 'none';
          btn.disabled = false;
        }
      }
    });
  });
</script>

<style>
  .auth-page-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 120px);
    padding: 24px 16px;
    background-color: var(--bg-deep);
    background-image: radial-gradient(circle at 50% 20%, rgba(230, 57, 70, 0.08) 0%, transparent 60%);
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    background-color: var(--bg-surface, #121212);
    border: 1px solid var(--border-subtle, #2A2A2A);
    border-radius: 16px;
    padding: 32px 28px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .auth-card-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 4px 10px;
    background-color: rgba(230, 57, 70, 0.12);
    border: 1px solid rgba(230, 57, 70, 0.25);
    border-radius: 9999px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #E63946;
  }

  .badge-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: #E63946;
    letter-spacing: 0.06em;
  }

  .auth-title {
    font-family: var(--font-hero);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    margin: 4px 0 0 0;
  }

  .auth-subtitle {
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: #A0A0A0;
    line-height: 1.45;
    margin: 0;
  }

  /* Tab Switcher */
  .auth-tab-row {
    display: flex;
    border-bottom: 1px solid #2A2A2A;
  }

  .auth-tab {
    flex: 1;
    padding: 12px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #A0A0A0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .auth-tab.active {
    color: #FFFFFF;
    border-bottom-color: #E63946;
  }

  .auth-tab:hover:not(.active) {
    color: #FFFFFF;
  }

  /* Error Alert */
  .auth-alert {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background-color: rgba(230, 57, 70, 0.15);
    border: 1px solid #E63946;
    border-radius: 8px;
    color: #FFB4AB;
    font-size: 0.84rem;
  }

  /* Forms */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .form-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: #A0A0A0;
    letter-spacing: 0.04em;
  }

  .forgot-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: #E63946;
    text-decoration: none;
  }

  .forgot-link:hover {
    text-decoration: underline;
  }

  .form-input {
    width: 100%;
    padding: 12px 14px;
    background-color: #1E1E1E;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    color: #FFFFFF;
    font-family: var(--font-body);
    font-size: 0.92rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input:focus {
    border-color: #E63946;
    box-shadow: 0 0 0 2px rgba(230, 57, 70, 0.2);
  }

  .btn-primary {
    margin-top: 6px;
    width: 100%;
    padding: 14px;
    background-color: #E63946;
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .btn-primary:hover {
    background-color: #d62b38;
  }

  .btn-primary:active {
    transform: scale(0.99);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .auth-card-footer {
    border-top: 1px solid #2A2A2A;
    padding-top: 16px;
  }

  .terms-notice {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: #666666;
    text-align: center;
    line-height: 1.4;
    margin: 0;
  }
</style>
