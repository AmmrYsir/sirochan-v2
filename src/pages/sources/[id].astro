---
import MainLayout from '../../layouts/MainLayout.astro';
import MangaCard from '../../components/media/MangaCard.astro';
import AnimeCard from '../../components/media/AnimeCard.astro';
import Badge from '../../components/common/Badge.astro';
import Button from '../../components/common/Button.astro';
import { ApiService } from '../../db/apiService';
import { MANGA_PLACEHOLDER, ANIME_PLACEHOLDER } from '../../utils/placeholders';


function formatHumanDate(dateStr?: string | null): string | null {
  if (
    !dateStr ||
    dateStr.trim() === '' ||
    dateStr === 'JUST NOW' ||
    dateStr === 'CLASSIC' ||
    dateStr === '2026-07-30'
  )
    return null;
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return null;

  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffHours >= 0 && diffHours < 1) return 'Just now';
  if (diffHours >= 1 && diffHours < 24) return `${diffHours}h ago`;
  if (diffDays >= 1 && diffDays < 7) return `${diffDays}d ago`;
  if (diffDays >= 7 && diffDays < 30)
    return `${Math.floor(diffDays / 7)}w ago`;

  return d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

const { id } = Astro.params;
const allSources = await ApiService.getSources();
const source = allSources.find(s => s.id === id) || allSources[0];

// Fetch live catalog items from http://localhost:8000 microservice!
const browseResult = await ApiService.browseSource(source.id);
const liveItems = browseResult.items;

const sourceMedia = liveItems.map(item => {
  const safeId = (item.sourceTitleId || 'title').replace(/[\/\s]/g, '-').toLowerCase();
  const rawDate = item.updatedAt || item.releasedAt || null;
  const humanDate = formatHumanDate(rawDate);
  const itemGenres = item.genres || item.tags || [item.mediaType.toUpperCase()];

  return {
    id: safeId,
    sourceId: item.sourceId || source.id,
    title: item.title,
    type: item.mediaType,
    coverImage: item.thumbnailUrl || MANGA_PLACEHOLDER,
    bannerImage: item.thumbnailUrl || ANIME_PLACEHOLDER,
    description: item.description || 'No description provided by source adapter.',
    rating: item.rating || 4.8,
    status: 'RELEASING' as const,
    genres: itemGenres,
    latestChapterOrEpisode: item.mediaType === 'manga' ? `CH. ${item.totalChapters || 100}` : `EP. ${item.totalEpisodes || 12}`,
    updatedAgo: humanDate || ''
  };
});

const popularItems = sourceMedia.slice(0, 4);
const rawGenres = sourceMedia.flatMap(m => m.genres || []);
const genres = ['All', ...Array.from(new Set(rawGenres)).filter(Boolean).sort()];
---

<MainLayout title={`${source.name} Provider - Sirochan`} activeTab="discover">
  <div class="source-dashboard container-constrained">
    <!-- Top Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/" class="bc-link">Home</a>
      <span class="bc-sep">/</span>
      <a href="/discover" class="bc-link">Sources</a>
      <span class="bc-sep">/</span>
      <span class="bc-current">{source.name}</span>
    </nav>

    <!-- Source Provider Masthead Banner -->
    <div class="source-masthead">
      <div class="masthead-main">
        <div class="source-avatar-icon">
          {source.icon && (source.icon.startsWith('http') || source.icon.startsWith('/')) ? (
            <img src={source.icon} alt={source.name} class="source-masthead-img-icon" onerror="this.style.display='none';" />
          ) : (
            <span>{source.icon || '⚡'}</span>
          )}
        </div>
        <div class="source-masthead-info">
          <div class="source-title-row">
            <h1 class="source-title">{source.name}</h1>
            <Badge variant={source.type === 'manga' ? 'red' : 'orange'}>
              {source.type.toUpperCase()} PROVIDER
            </Badge>
          </div>
          <p class="source-desc">{source.description}</p>
          <div class="source-stats-row">
            <span class="stat-tag"><span class="ping-dot"></span> {source.status} ({source.pingMs}ms)</span>
            <span class="stat-sep">•</span>
            <span class="stat-tag">{source.itemCount} CATALOG ITEMS</span>
            <span class="stat-sep">•</span>
            <span class="stat-tag">LANG: {source.language}</span>
          </div>
        </div>
      </div>

      <!-- Action Button Group -->
      <div class="source-actions">
        <Button variant="secondary" size="md" id="pin-btn">
          📌 PIN TO QUICK ACCESS
        </Button>
        <a href={source.description?.match(/https?:\/\/[^\s]+/)?.[0] || '#'} target="_blank" rel="noopener noreferrer">
          <Button variant="outline" size="md">
            🌐 OPEN OFFICIAL WEB
          </Button>
        </a>
      </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="catalog-toolbar">
      <!-- Catalog Search Field -->
      <div class="catalog-search-box">
        <span class="search-icon">🔍</span>
        <input 
          type="text" 
          id="catalog-search" 
          placeholder={`Search ${source.name} catalog...`} 
          class="catalog-search-input" 
        />
      </div>

      <!-- Genre Filter Pills -->
      <div class="genre-filter-row">
        {genres.map((g, idx) => (
          <button class={`genre-chip ${idx === 0 ? 'active' : ''}`} data-genre={g}>
            {g}
          </button>
        ))}
      </div>
    </div>

    <!-- Popular on This Source Section -->
    <section class="catalog-section">
      <div class="section-header">
        <h2 class="section-title">POPULAR ON {source.name.toUpperCase()}</h2>
      </div>
      <div class="scroll-row hide-scrollbar">
        {popularItems.map(item => (
          item.type === 'manga' ? (
            <MangaCard item={item} />
          ) : (
            <AnimeCard item={item} />
          )
        ))}
      </div>
    </section>

    <!-- Full Source Catalog Grid -->
    <section class="catalog-section">
      <div class="section-header-row">
        <h2 class="section-title">ALL CATALOG TITLES ({sourceMedia.length})</h2>
        <div class="sort-segmented-control">
          <span class="sort-icon-label">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
            SORT
          </span>
          <div class="sort-pills-wrapper">
            <button class="sort-pill active" data-sort="latest">
              <span>Latest</span>
              <svg class="sort-arrow-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <button class="sort-pill" data-sort="oldest">
              <span>Oldest</span>
              <svg class="sort-arrow-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="media-grid" id="catalog-grid">
        {sourceMedia.map(item => (
          item.type === 'manga' ? (
            <MangaCard item={item} />
          ) : (
            <AnimeCard item={item} />
          )
        ))}
      </div>
      <div class="empty-catalog-state hidden" id="empty-state">
        <span class="empty-icon">🔍</span>
        <p>No matching titles found in this catalog.</p>
      </div>
    </section>
  </div>
</MainLayout>

<script>
  const searchInput = document.getElementById('catalog-search') as HTMLInputElement;
  const genreChips = document.querySelectorAll('.genre-chip');
  const mediaCards = document.querySelectorAll('.manga-card, .anime-card');
  const sortBtns = document.querySelectorAll('.sort-pill');
  const gridContainer = document.getElementById('catalog-grid');

  const emptyStateEl = document.getElementById('empty-state');

  let currentGenre = 'All';
  let currentSearch = '';

  function filterCatalog() {
    let visibleCount = 0;
    mediaCards.forEach(card => {
      const cardEl = card as HTMLElement;
      const title = (cardEl.getAttribute('data-title') || cardEl.querySelector('.card-title')?.textContent || '').toLowerCase();
      const genres = (cardEl.getAttribute('data-genres') || '').toLowerCase();

      const matchesSearch = !currentSearch || title.includes(currentSearch);
      const matchesGenre = currentGenre === 'All' || genres.includes(currentGenre.toLowerCase());

      if (matchesSearch && matchesGenre) {
        cardEl.style.display = 'flex';
        visibleCount++;
      } else {
        cardEl.style.display = 'none';
      }
    });

    if (emptyStateEl) {
      if (visibleCount === 0) {
        emptyStateEl.classList.remove('hidden');
      } else {
        emptyStateEl.classList.add('hidden');
      }
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterCatalog();
    });
  }

  genreChips.forEach(chip => {
    chip.addEventListener('click', () => {
      genreChips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentGenre = chip.getAttribute('data-genre') || 'All';
      filterCatalog();
    });
  });

  if (gridContainer) {
    sortBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const sort = btn.getAttribute('data-sort');
        sortBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const cards = Array.from(gridContainer.children) as HTMLElement[];
        cards.reverse();
        cards.forEach(card => gridContainer.appendChild(card));
      });
    });
  }
</script>

<style>
  .source-dashboard {
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .bc-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .bc-link:hover {
    color: #ffffff;
  }

  .bc-sep {
    color: var(--text-dim);
  }

  .bc-current {
    color: var(--accent-red);
    font-weight: 700;
  }

  .source-masthead {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 768px) {
    .source-masthead {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .masthead-main {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .source-avatar-icon {
    font-size: 2.5rem;
    line-height: 1;
    padding: 12px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .source-masthead-img-icon {
    width: 42px;
    height: 42px;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .source-masthead-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .source-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .source-title {
    font-family: var(--font-hero);
    font-size: 1.8rem;
    font-weight: 800;
  }

  .source-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .source-stats-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .ping-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: #2ec4b6;
    display: inline-block;
  }

  .stat-sep {
    color: var(--text-dim);
  }

  .source-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .catalog-toolbar {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 768px) {
    .catalog-toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .catalog-search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 16px;
    width: 100%;
    max-width: 380px;
  }

  .catalog-search-box:focus-within {
    border-color: var(--accent-red);
  }

  .catalog-search-input {
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.9rem;
    width: 100%;
  }

  .genre-filter-row {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .genre-chip {
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .genre-chip.active, .genre-chip:hover {
    background-color: var(--bg-elevated);
    color: #ffffff;
    border-color: var(--text-muted);
  }

  .catalog-section {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 36px;
  }

  .section-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 12px;
  }

  .section-title {
    font-family: var(--font-hero);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .sort-segmented-control {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(22, 22, 26, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 3px 4px 3px 12px;
  }

  .sort-icon-label {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .sort-pills-wrapper {
    display: flex;
    align-items: center;
    gap: 2px;
    background-color: var(--bg-surface);
    border-radius: var(--radius-full);
    padding: 2px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sort-pill {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sort-pill:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.06);
  }

  .sort-pill.active {
    background-color: var(--accent-red);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(230, 57, 70, 0.4);
  }

  .sort-arrow-icon {
    opacity: 0.7;
    transition: transform 0.2s ease;
  }

  .sort-pill:hover .sort-arrow-icon {
    opacity: 1;
  }

  .scroll-row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 12px;
    align-items: flex-start;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
    gap: 24px 16px;
    align-items: start;
  }

  @media (min-width: 640px) {
    .media-grid {
      grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
      gap: 28px 20px;
    }
  }

  @media (min-width: 1024px) {
    .media-grid {
      grid-template-columns: repeat(auto-fill, minmax(195px, 1fr));
      gap: 32px 24px;
    }
  }

  .empty-catalog-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
    text-align: center;
    gap: 10px;
    margin-top: 12px;
  }

  .empty-icon {
    font-size: 2rem;
  }

</style>
