---
import MainLayout from '../../layouts/MainLayout.astro';
import MangaCard from '../../components/media/MangaCard.astro';
import AnimeCard from '../../components/media/AnimeCard.astro';
import Badge from '../../components/common/Badge.astro';
import Button from '../../components/common/Button.astro';
import { ApiService } from '../../db/apiService';
import { MANGA_PLACEHOLDER, ANIME_PLACEHOLDER } from '../../utils/placeholders';


function formatHumanDate(dateStr?: string | null): string | null {
  if (
    !dateStr ||
    dateStr.trim() === '' ||
    dateStr === 'JUST NOW' ||
    dateStr === 'CLASSIC' ||
    dateStr === '2026-07-30'
  )
    return null;
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return null;

  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffHours >= 0 && diffHours < 1) return 'Just now';
  if (diffHours >= 1 && diffHours < 24) return `${diffHours}h ago`;
  if (diffDays >= 1 && diffDays < 7) return `${diffDays}d ago`;
  if (diffDays >= 7 && diffDays < 30)
    return `${Math.floor(diffDays / 7)}w ago`;

  return d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

const { id } = Astro.params;
const sourceId = id || 'mangadex';
const manifest = await ApiService.getSourceManifest(sourceId);
const allSources = await ApiService.getSources();
const source = allSources.find(s => s.id === sourceId) || {
  id: sourceId,
  name: manifest?.name || sourceId,
  type: 'manga' as const,
  language: 'EN',
  icon: manifest?.iconUrl || '📚',
  status: 'ONLINE' as const,
  pingMs: 18,
  itemCount: '10,000+',
  description: manifest?.description || '',
  filters: manifest?.browseConfig?.filters || [],
  categories: []
};

const backendFilters = manifest?.browseConfig?.filters || source.filters || [];

// Fetch live catalog items from http://localhost:8000 microservice!
const browseResult = await ApiService.browseSource(source.id);
const liveItems = browseResult.items;

const sourceMedia = liveItems.map(item => {
  const safeId = (item.sourceTitleId || 'title').replace(/[\/\s]/g, '-').toLowerCase();
  const rawDate = item.updatedAt || item.releasedAt || null;
  const humanDate = formatHumanDate(rawDate);
  const itemGenres = item.genres || item.tags || [item.mediaType.toUpperCase()];

  return {
    id: safeId,
    sourceId: item.sourceId || source.id,
    title: item.title,
    type: item.mediaType,
    coverImage: item.thumbnailUrl || MANGA_PLACEHOLDER,
    bannerImage: item.thumbnailUrl || ANIME_PLACEHOLDER,
    description: item.description || 'No description provided by source adapter.',
    rating: item.rating || 4.8,
    status: 'RELEASING' as const,
    genres: itemGenres,
    latestChapterOrEpisode: item.mediaType === 'manga' ? `CH. ${item.totalChapters || 100}` : `EP. ${item.totalEpisodes || 12}`,
    updatedAgo: humanDate || ''
  };
});

const popularItems = sourceMedia.slice(0, 4);

---

<MainLayout title={`${source.name} Provider - Sirochan`} activeTab="discover">
  <div class="source-dashboard container-constrained">
    <!-- Top Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/" class="bc-link">Home</a>
      <span class="bc-sep">/</span>
      <a href="/discover" class="bc-link">Sources</a>
      <span class="bc-sep">/</span>
      <span class="bc-current">{source.name}</span>
    </nav>

    <!-- Source Provider Masthead Banner -->
    <div class="source-masthead">
      <div class="masthead-main">
        <div class="source-avatar-icon">
          {source.icon && (source.icon.startsWith('http') || source.icon.startsWith('/')) ? (
            <img src={source.icon} alt={source.name} class="source-masthead-img-icon" onerror="this.style.display='none';" />
          ) : (
            <span>{source.icon || '⚡'}</span>
          )}
        </div>
        <div class="source-masthead-info">
          <div class="source-title-row">
            <h1 class="source-title">{source.name}</h1>
            <Badge variant={source.type === 'manga' ? 'red' : 'orange'}>
              {source.type.toUpperCase()} PROVIDER
            </Badge>
          </div>
          <p class="source-desc">{source.description}</p>
          <div class="source-stats-row">
            <span class="stat-tag"><span class="ping-dot"></span> {source.status} ({source.pingMs}ms)</span>
            <span class="stat-sep">•</span>
            <span class="stat-tag">{source.itemCount} CATALOG ITEMS</span>
            <span class="stat-sep">•</span>
            <span class="stat-tag">LANG: {source.language}</span>
          </div>
        </div>
      </div>

      <!-- Action Button Group -->
      <div class="source-actions">
        <Button variant="secondary" size="md" id="pin-btn">
          📌 PIN TO QUICK ACCESS
        </Button>
        <a href={source.description?.match(/https?:\/\/[^\s]+/)?.[0] || '#'} target="_blank" rel="noopener noreferrer">
          <Button variant="outline" size="md">
            🌐 OPEN OFFICIAL WEB
          </Button>
        </a>
      </div>
    </div>

    <!-- Full-Width Hero Catalog Search Bar -->
    <div class="hero-search-wrapper">
      <div class="catalog-search-box">
        <span class="search-icon">🔍</span>
        <input 
          type="text" 
          id="catalog-search" 
          placeholder={`Search titles, tags, or keywords in ${source.name}...`} 
          class="catalog-search-input" 
        />
      </div>
    </div>

    <!-- Popular on This Source Section -->
    <section class="catalog-section">
      <div class="section-header">
        <h2 class="section-title">POPULAR ON {source.name.toUpperCase()}</h2>
      </div>
      <div class="scroll-row hide-scrollbar">
        {popularItems.map(item => (
          item.type === 'manga' ? (
            <MangaCard item={item} />
          ) : (
            <AnimeCard item={item} />
          )
        ))}
      </div>
    </section>

    <!-- Full Source Catalog Grid -->
    <section class="catalog-section">
      <div class="section-header-row">
        <h2 class="section-title" id="catalog-title-header">ALL CATALOG TITLES ({sourceMedia.length})</h2>

        {backendFilters.length > 0 && (
          <div class="backend-filters-row">
            {backendFilters.map(f => (
              f.type === 'select' && f.options && f.options.length > 0 ? (
                <div class="filter-group">
                  <label class="filter-label" for={`filter-${f.key}`}>{f.label}:</label>
                  <select class="backend-filter-select" id={`filter-${f.key}`} data-filter-key={f.key}>
                    {f.options.map(opt => (
                      <option value={opt.value} selected={opt.value === f.defaultValue}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                </div>
              ) : f.type === 'text' ? (
                <div class="filter-group">
                  <label class="filter-label" for={`filter-${f.key}`}>{f.label}:</label>
                  <input type="text" class="backend-filter-input" id={`filter-${f.key}`} data-filter-key={f.key} placeholder={f.placeholder || f.label} />
                </div>
              ) : null
            ))}
            <button type="button" class="clear-filters-btn" id="clear-filters-btn" title="Reset all filters">
              ✕ RESET
            </button>
          </div>
        )}
      </div>

      <div class="media-grid" id="catalog-grid" data-source-id={source.id}>
        {sourceMedia.map(item => (
          item.type === 'manga' ? (
            <MangaCard item={item} />
          ) : (
            <AnimeCard item={item} />
          )
        ))}
      </div>
      <div class="empty-catalog-state hidden" id="empty-state">
        <span class="empty-icon">🔍</span>
        <p>No matching titles found in this catalog.</p>
      </div>
    </section>
  </div>
</MainLayout>

<script>
  const gridContainer = document.getElementById('catalog-grid') as HTMLElement;
  const sourceId = gridContainer?.getAttribute('data-source-id') || 'nhentai';
  const filterSelects = document.querySelectorAll('.backend-filter-select') as NodeListOf<HTMLSelectElement>;
  const filterInputs = document.querySelectorAll('.backend-filter-input') as NodeListOf<HTMLInputElement>;
  const searchInput = document.getElementById('catalog-search') as HTMLInputElement;
  const clearFiltersBtn = document.getElementById('clear-filters-btn') as HTMLButtonElement;
  const titleHeader = document.getElementById('catalog-title-header') as HTMLElement;
  const sortBtns = document.querySelectorAll('.sort-pill');
  const emptyStateEl = document.getElementById('empty-state');

  const MANGA_PLACEHOLDER = "data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='300' height='400' viewBox='0 0 300 400'%3E%3Crect width='300' height='400' fill='%2318181b'/%3E%3Ctext x='50%25' y='45%25' dominant-baseline='middle' text-anchor='middle' font-family='sans-serif' font-size='48' fill='%233f3f46'%3E📚%3C/text%3E%3Ctext x='50%25' y='60%25' dominant-baseline='middle' text-anchor='middle' font-family='sans-serif' font-size='12' font-weight='bold' fill='%2371717a' letter-spacing='2'%3ENON-PREVIEW%3C/text%3E%3C/svg%3E";
  const ANIME_PLACEHOLDER = "data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='400' height='225' viewBox='0 0 400 225'%3E%3Crect width='400' height='225' fill='%2318181b'/%3E%3Ctext x='50%25' y='45%25' dominant-baseline='middle' text-anchor='middle' font-family='sans-serif' font-size='40' fill='%233f3f46'%3E⚡%3C/text%3E%3Ctext x='50%25' y='62%25' dominant-baseline='middle' text-anchor='middle' font-family='sans-serif' font-size='12' font-weight='bold' fill='%2371717a' letter-spacing='2'%3ENON-PREVIEW%3C/text%3E%3C/svg%3E";

  let debounceTimer: any = null;

  async function executeBackendFilter() {
    const filters: Record<string, any> = {};
    
    filterSelects.forEach(sel => {
      const key = sel.getAttribute('data-filter-key');
      if (key && sel.value) {
        filters[key] = sel.value;
      }
    });

    filterInputs.forEach(inp => {
      const key = inp.getAttribute('data-filter-key');
      if (key && inp.value.trim()) {
        filters[key] = inp.value.trim();
      }
    });

    const query = searchInput?.value.trim() || null;

    if (gridContainer) gridContainer.style.opacity = '0.4';

    try {
      const res = await fetch(`http://localhost:8000/api/v1/sources/${sourceId}/browse`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query, page: 1, filters })
      });
      if (!res.ok) return;
      const data = await res.json();
      if (!data || !Array.isArray(data.items)) return;

      const items = data.items;

      if (titleHeader) {
        titleHeader.textContent = `ALL CATALOG TITLES (${items.length})`;
      }

      if (gridContainer) {
        if (items.length === 0) {
          gridContainer.innerHTML = '';
          if (emptyStateEl) emptyStateEl.classList.remove('hidden');
        } else {
          if (emptyStateEl) emptyStateEl.classList.add('hidden');

          gridContainer.innerHTML = items.map((item: any) => {
            const safeId = (item.sourceTitleId || 'title').replace(/[\/\s]/g, '-').toLowerCase();
            const href = `/${item.sourceId || sourceId}/${safeId}`;
            const cover = item.thumbnailUrl || MANGA_PLACEHOLDER;
            const isAnime = item.mediaType === 'anime';

            if (isAnime) {
              return `
                <a href="${href}" class="anime-card" data-type="anime" data-title="${item.title.toLowerCase()}">
                  <div class="card-thumb-container">
                    <img src="${cover}" alt="${item.title}" class="card-thumb" loading="lazy" data-fallback="${ANIME_PLACEHOLDER}" onerror="this.onerror=null; this.src=this.dataset.fallback;" />
                    <div class="play-overlay">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    </div>
                  </div>
                  <div class="card-info">
                    <h3 class="card-title">${item.title}</h3>
                    <p class="card-meta">EP. ${item.totalEpisodes || 12}</p>
                  </div>
                </a>
              `;
            } else {
              return `
                <a href="${href}" class="manga-card" data-type="manga" data-title="${item.title.toLowerCase()}">
                  <div class="card-cover-container">
                    <img src="${cover}" alt="${item.title}" class="card-cover" loading="lazy" data-fallback="${MANGA_PLACEHOLDER}" onerror="this.onerror=null; this.src=this.dataset.fallback;" />
                  </div>
                  <div class="card-info">
                    <h3 class="card-title">${item.title}</h3>
                    <p class="card-meta">CH. ${item.totalChapters || 100}</p>
                  </div>
                </a>
              `;
            }
          }).join('');
        }
      }
    } catch (err) {
      console.error('[ClientFilter] Error querying loouwd microservice:', err);
    } finally {
      if (gridContainer) gridContainer.style.opacity = '1.0';
    }
  }

  filterSelects.forEach(sel => {
    sel.addEventListener('change', executeBackendFilter);
  });

  filterInputs.forEach(inp => {
    inp.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(executeBackendFilter, 300);
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(executeBackendFilter, 300);
    });
  }

  if (clearFiltersBtn) {
    clearFiltersBtn.addEventListener('click', () => {
      filterSelects.forEach(sel => sel.selectedIndex = 0);
      filterInputs.forEach(inp => inp.value = '');
      if (searchInput) searchInput.value = '';
      executeBackendFilter();
    });
  }

  if (gridContainer) {
    sortBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const sort = btn.getAttribute('data-sort');
        sortBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const cards = Array.from(gridContainer.children) as HTMLElement[];
        cards.reverse();
        cards.forEach(card => gridContainer.appendChild(card));
      });
    });
  }
</script>

<style>
  .source-dashboard {
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .bc-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .bc-link:hover {
    color: #ffffff;
  }

  .bc-sep {
    color: var(--text-dim);
  }

  .bc-current {
    color: var(--accent-red);
    font-weight: 700;
  }

  .source-masthead {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 768px) {
    .source-masthead {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .masthead-main {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .source-avatar-icon {
    font-size: 2.5rem;
    line-height: 1;
    padding: 12px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .source-masthead-img-icon {
    width: 42px;
    height: 42px;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .source-masthead-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .source-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .source-title {
    font-family: var(--font-hero);
    font-size: 1.8rem;
    font-weight: 800;
  }

  .source-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .source-stats-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .ping-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: #2ec4b6;
    display: inline-block;
  }

  .stat-sep {
    color: var(--text-dim);
  }

  .source-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero-search-wrapper {
    margin-bottom: 24px;
    width: 100%;
  }

  .catalog-search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 12px 20px;
    width: 100%;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .catalog-search-box:focus-within {
    border-color: var(--accent-red);
    box-shadow: 0 0 0 2px rgba(230, 57, 70, 0.25);
    background-color: var(--bg-elevated);
  }

  .search-icon {
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .catalog-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-weight: 500;
  }

  .catalog-search-input::placeholder {
    color: var(--text-muted);
  }

  .catalog-section {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 36px;
  }

  .section-header-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 12px;
  }

  @media (min-width: 768px) {
    .section-header-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .section-title {
    font-family: var(--font-hero);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .backend-filters-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .backend-filter-select, .backend-filter-input {
    background-color: var(--bg-surface);
    color: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 7px 12px;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    outline: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .backend-filter-select:hover, .backend-filter-input:hover {
    border-color: var(--text-muted);
    background-color: var(--bg-elevated);
  }

  .backend-filter-select:focus, .backend-filter-input:focus {
    border-color: var(--accent-red);
    background-color: var(--bg-elevated);
  }

  .clear-filters-btn {
    background-color: var(--bg-surface);
    color: var(--accent-red);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .clear-filters-btn:hover {
    background-color: var(--accent-red);
    color: #ffffff;
    border-color: var(--accent-red);
  }

  .sort-segmented-control {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(22, 22, 26, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 3px 4px 3px 12px;
  }

  .sort-icon-label {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .sort-pills-wrapper {
    display: flex;
    align-items: center;
    gap: 2px;
    background-color: var(--bg-surface);
    border-radius: var(--radius-full);
    padding: 2px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sort-pill {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sort-pill:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.06);
  }

  .sort-pill.active {
    background-color: var(--accent-red);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(230, 57, 70, 0.4);
  }

  .sort-arrow-icon {
    opacity: 0.7;
    transition: transform 0.2s ease;
  }

  .sort-pill:hover .sort-arrow-icon {
    opacity: 1;
  }

  .scroll-row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 12px;
    align-items: flex-start;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
    gap: 24px 16px;
    align-items: start;
  }

  @media (min-width: 640px) {
    .media-grid {
      grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
      gap: 28px 20px;
    }
  }

  @media (min-width: 1024px) {
    .media-grid {
      grid-template-columns: repeat(auto-fill, minmax(195px, 1fr));
      gap: 32px 24px;
    }
  }

  .empty-catalog-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
