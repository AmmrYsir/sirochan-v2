---
import MainLayout from '../layouts/MainLayout.astro';
import HeroBanner from '../components/media/HeroBanner.astro';
import MangaCard from '../components/media/MangaCard.astro';
import AnimeCard from '../components/media/AnimeCard.astro';
import EditorialItem from '../components/media/EditorialItem.astro';
import Badge from '../components/common/Badge.astro';
import { ApiService } from '../db/apiService';
import { currentUser } from '../db/mockData';

// Fetch live media feeds directly from loouwd microservice (http://localhost:8000)
const liveMangaFeed = await ApiService.unifiedFeed('manga');
const liveAnimeFeed = await ApiService.unifiedFeed('anime');

const realMangaItems = liveMangaFeed.items.map(item => {
  const safeId = (item.sourceTitleId || 'manga').replace(/[\/\s]/g, '-').toLowerCase();
  return {
    id: safeId,
    title: item.title,
    type: 'manga' as const,
    coverImage: item.thumbnailUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80',
    bannerImage: item.thumbnailUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80',
    description: item.description || 'Live item from provider adapter.',
    rating: item.rating || 4.8,
    status: 'RELEASING' as const,
    genres: ['Action', 'Fantasy'],
    latestChapterOrEpisode: `CH. ${item.totalChapters || 100}`,
    updatedAgo: 'JUST NOW',
    progressPercent: 45
  };
});

const realAnimeItems = liveAnimeFeed.items.map(item => {
  const safeId = (item.sourceTitleId || 'anime').replace(/[\/\s]/g, '-').toLowerCase();
  return {
    id: safeId,
    title: item.title,
    type: 'anime' as const,
    coverImage: item.thumbnailUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80',
    bannerImage: item.thumbnailUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80',
    description: item.description || 'Live item from provider adapter.',
    rating: item.rating || 4.9,
    status: 'RELEASING' as const,
    genres: ['Action', 'Sci-Fi'],
    latestChapterOrEpisode: `EP. ${item.totalEpisodes || 12}`,
    updatedAgo: 'JUST NOW',
    progressPercent: 75
  };
});

const defaultItem = {
  id: 'live-media',
  title: 'SIROCHAN LIVE STREAM',
  japaneseTitle: 'シロチャン',
  type: 'manga' as const,
  coverImage: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80',
  bannerImage: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80',
  description: 'Explore live manga and anime streams directly from microservice source registry.',
  rating: 5.0,
  status: 'RELEASING' as const,
  genres: ['Action', 'Fantasy'],
  latestChapterOrEpisode: 'LIVE',
  updatedAgo: 'JUST NOW'
};

const continueReading = realMangaItems;
const continueWatching = realAnimeItems;

const heroItem = continueReading[0] || continueWatching[0] || defaultItem;
const trendingItem = continueWatching[0] || continueReading[0] || defaultItem;
const trendingGrid = continueWatching.slice(1, 5);
const editorialSelections = continueReading.slice(1, 3);
---

<MainLayout title="Sirochan - Unified Manga & Anime Platform" activeTab="home">
  <!-- Hero Featured Banner -->
  <HeroBanner item={heroItem} />

  <div class="main-content container-constrained">
    <!-- User Greeting Section -->
    <section class="user-greeting-section">
      <h2 class="user-greeting">Good evening, {currentUser.username}</h2>
    </section>

    <!-- Continue Reading Row -->
    <section class="feed-section">
      <div class="section-header">
        <h3 class="section-title">CONTINUE READING</h3>
        <a href="/library" class="section-more">See all</a>
      </div>
      <div class="scroll-row hide-scrollbar">
        {continueReading.map(item => (
          <MangaCard item={item} />
        ))}
      </div>
    </section>

    <!-- Continue Watching Row -->
    <section class="feed-section">
      <div class="section-header">
        <h3 class="section-title">CONTINUE WATCHING</h3>
        <a href="/library" class="section-more">See all</a>
      </div>
      <div class="scroll-row hide-scrollbar">
        {continueWatching.map(item => (
          <AnimeCard item={item} />
        ))}
      </div>
    </section>

    <!-- Trending Now Section -->
    <section class="feed-section">
      <div class="section-header">
        <h3 class="section-title">TRENDING NOW</h3>
      </div>
      
      <!-- Trending Hero Spotlight (Blue Lock) -->
      <div class="trending-hero-card">
        <img src={trendingItem.bannerImage} alt={trendingItem.title} class="trending-hero-img" />
        <div class="trending-hero-overlay"></div>
        <div class="trending-hero-content">
          <Badge variant="red" class="trending-badge">#1 TRENDING</Badge>
          <h3 class="trending-hero-title">{trendingItem.title}</h3>
        </div>
        <button class="bookmark-btn" aria-label="Bookmark">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
        </button>
      </div>

      <!-- Trending Grid 2x2 -->
      <div class="trending-grid">
        {trendingGrid.map(item => (
          <a href={`/${item.type}/${item.id}`} class="trending-grid-item">
            <div class="grid-item-thumb">
              <img src={item.coverImage} alt={item.title} />
            </div>
            <div class="grid-item-info">
              <h4 class="grid-item-title">{item.title}</h4>
              <p class="grid-item-desc">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Editorial Selections -->
    <section class="feed-section">
      <div class="section-header">
        <h3 class="section-title">THE SELECTION CURATED BY OUR EDITORS</h3>
      </div>
      <div class="editorial-stack">
        {editorialSelections.map(item => (
          <EditorialItem item={item} />
        ))}
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .main-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .user-greeting {
    font-family: var(--font-hero);
    font-size: 24px;
    font-weight: 700;
    line-height: 32px;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .feed-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .section-more {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .section-more:hover {
    color: var(--accent-red);
  }

  .scroll-row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
    margin-left: -16px;
    margin-right: -16px;
    padding-left: 16px;
    padding-right: 16px;
  }

  @media (min-width: 768px) {
    .scroll-row {
      margin-left: 0;
      margin-right: 0;
      padding-left: 0;
      padding-right: 0;
    }
  }

  /* Trending Hero Card */
  .trending-hero-card {
    position: relative;
    width: 100%;
    height: 220px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .trending-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .trending-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 60%);
  }

  .trending-hero-content {
    position: absolute;
    bottom: 20px;
    left: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .trending-hero-title {
    font-family: var(--font-hero);
    font-size: 24px;
    font-weight: 800;
    line-height: 32px;
    color: #ffffff;
  }

  .bookmark-btn {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--accent-red);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(230, 57, 70, 0.4);
  }

  /* Trending Grid */
  .trending-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media (min-width: 768px) {
    .trending-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trending-grid-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }

  .grid-item-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .grid-item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .grid-item-title {
    font-family: var(--font-hero);
    font-size: 15px;
    font-weight: 700;
    line-height: 20px;
    color: var(--text-primary);
  }

  .grid-item-desc {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 18px;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .editorial-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
</style>
