---
import MainLayout from '../layouts/MainLayout.astro';
import HeroBanner from '../components/media/HeroBanner.astro';
import MangaCard from '../components/media/MangaCard.astro';
import AnimeCard from '../components/media/AnimeCard.astro';
import EditorialItem from '../components/media/EditorialItem.astro';
import Badge from '../components/common/Badge.astro';
import { currentUser } from '../db/mockData';
import { ApiService } from '../db/apiService';
import { getPrivacyTitleUrl } from '../utils/privacy';

// Fetch live sources & browse catalog
let heroItem: any;
let continueReading: any[] = [];
let continueWatching: any[] = [];
let trendingSpotlight: any;
let trendingGrid: any[] = [];
let editorialSelections: any[] = [];

try {
  const sources = await ApiService.getSources();
  const browseResults = await Promise.all(
    sources.map(src => ApiService.browseSource(src.id))
  );

  const allLiveItems = browseResults.flatMap((res, i) => {
    const srcId = sources[i]?.id || 'mangadex';
    return res.items.map(item => ({
      ...item,
      sourceId: srcId
    }));
  });

  const formattedLiveItems = allLiveItems.map(item => {
    const isAnime = item.mediaType === 'anime';
    return {
      id: item.sourceTitleId,
      sourceId: item.sourceId,
      sourceTitleId: item.sourceTitleId,
      title: item.title,
      japaneseTitle: item.title,
      type: item.mediaType,
      coverImage: item.thumbnailUrl || (isAnime 
        ? 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80'
        : 'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=600&q=80'),
      bannerImage: item.thumbnailUrl || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80',
      description: item.description || `Read or watch ${item.title} live on Sirochan v2.`,
      rating: item.rating || 4.9,
      status: 'RELEASING' as const,
      genres: item.genres && item.genres.length > 0 ? item.genres : [isAnime ? 'Anime Stream' : 'Manga'],
      latestChapterOrEpisode: isAnime ? `EP. ${item.totalEpisodes || 'HD'}` : `CH. ${item.totalChapters || 'NEW'}`,
      updatedAgo: 'RECENT',
      progressPercent: Math.floor(Math.random() * 50) + 35
    };
  });

  const mangaItems = formattedLiveItems.filter(item => item.type === 'manga');
  const animeItems = formattedLiveItems.filter(item => item.type === 'anime');

  heroItem = formattedLiveItems[0] || {
    id: 'select-source',
    sourceId: 'mangadex',
    title: 'SIROCHAN PLATFORM',
    type: 'manga' as const,
    coverImage: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80',
    bannerImage: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80',
    description: 'Welcome to Sirochan v2. Select a provider source from Discover to start reading manga or watching anime streams.',
    rating: 5.0,
    status: 'RELEASING' as const,
    genres: ['Action', 'Fantasy'],
    latestChapterOrEpisode: 'ONLINE',
    updatedAgo: 'JUST NOW'
  };

  continueReading = mangaItems.slice(0, 10);
  continueWatching = animeItems.slice(0, 10);
  trendingSpotlight = formattedLiveItems[1] || heroItem;
  trendingGrid = formattedLiveItems.slice(2, 10);
  editorialSelections = formattedLiveItems.slice(10, 16);
} catch (err) {
  console.error('[Dashboard] Error fetching live media items:', err);
}
---

<MainLayout title="Sirochan - Manga & Anime Platform" activeTab="home">
  <!-- Hero Featured Banner -->
  {heroItem && <HeroBanner item={heroItem} />}

  <div class="main-content container-constrained">
    <!-- User Greeting Section -->
    <section class="user-greeting-section">
      <h2 class="user-greeting">Good evening, {currentUser.username}</h2>
      <p class="user-subtext">Pick up right where you left off across your active reading and streaming channels.</p>
    </section>

    <!-- Continue Reading Row -->
    {continueReading.length > 0 && (
      <section class="feed-section">
        <div class="section-header-row">
          <div class="header-title-group">
            <h2 class="section-title">CONTINUE READING</h2>
            <span class="section-badge-dot"></span>
          </div>
          <a href="/library" class="view-all-link">VIEW LIBRARY →</a>
        </div>
        <div class="scroll-row hide-scrollbar">
          {continueReading.map((item) => (
            <MangaCard item={item} />
          ))}
        </div>
      </section>
    )}

    <!-- Continue Watching Row -->
    {continueWatching.length > 0 && (
      <section class="feed-section">
        <div class="section-header-row">
          <div class="header-title-group">
            <h2 class="section-title">CONTINUE WATCHING</h2>
            <span class="section-badge-dot orange"></span>
          </div>
          <a href="/library" class="view-all-link">VIEW LIBRARY →</a>
        </div>
        <div class="scroll-row hide-scrollbar">
          {continueWatching.map((item) => (
            <AnimeCard item={item} />
          ))}
        </div>
      </section>
    )}

    <!-- Trending & Editorial Split Layout -->
    <div class="split-layout">
      <!-- Left Column: Trending Section -->
      <section class="feed-section trending-section">
        <div class="section-header-row">
          <div class="header-title-group">
            <h2 class="section-title">TRENDING SPOTLIGHT</h2>
            <Badge variant="red">HOT</Badge>
          </div>
        </div>

        {trendingSpotlight && (
          <div class="trending-spotlight">
            <a href={getPrivacyTitleUrl({ sourceId: trendingSpotlight.sourceId, sourceTitleId: trendingSpotlight.sourceTitleId || trendingSpotlight.id, id: trendingSpotlight.id })} class="spotlight-banner-card">
              <div class="spotlight-cover-col">
                <img src={trendingSpotlight.coverImage} alt={trendingSpotlight.title} class="spotlight-cover-img" />
                <span class="spotlight-type-badge">{trendingSpotlight.type.toUpperCase()}</span>
              </div>
              <div class="spotlight-info-col">
                <div class="spotlight-top-tags">
                  <span class="rank-tag">#1 TRENDING</span>
                  <span class="rating-tag">★ {trendingSpotlight.rating}</span>
                </div>
                <h3 class="spotlight-title">{trendingSpotlight.title}</h3>
                <p class="spotlight-desc">{trendingSpotlight.description}</p>
                <div class="spotlight-footer">
                  <span class="spotlight-ch-meta">{trendingSpotlight.latestChapterOrEpisode}</span>
                  <span class="spotlight-cta">EXPLORE TITLE →</span>
                </div>
              </div>
            </a>
          </div>
        )}

        {trendingGrid.length > 0 && (
          <div class="trending-grid responsive-media-grid">
            {trendingGrid.map((item) => (
              item.type === 'manga' ? <MangaCard item={item} /> : <AnimeCard item={item} />
            ))}
          </div>
        )}
      </section>

      <!-- Right Column: Curated Editorials -->
      <section class="feed-section editorial-section">
        <div class="section-header-row">
          <div class="header-title-group">
            <h2 class="section-title">CURATED EDITORIALS</h2>
          </div>
        </div>

        {editorialSelections.length > 0 ? (
          <div class="editorial-stack">
            {editorialSelections.map((item) => (
              <EditorialItem item={item} />
            ))}
          </div>
        ) : (
          <div class="empty-editorial-box">
            <p>Select a provider source to start populating your feed.</p>
            <a href="/discover" class="btn-discover">BROWSE SOURCES →</a>
          </div>
        )}
      </section>
    </div>
  </div>
</MainLayout>

<style>
  .main-content {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-top: 24px;
    padding-bottom: 40px;
  }

  .user-greeting-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: -4px;
  }

  .user-greeting {
    font-family: var(--font-hero);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .user-subtext {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .feed-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 10px;
  }

  .header-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-title {
    font-family: var(--font-hero);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #ffffff;
  }

  .section-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--accent-red);
    display: inline-block;
  }

  .section-badge-dot.orange {
    background-color: var(--accent-orange);
  }

  .view-all-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color 0.2s ease;
  }

  .view-all-link:hover {
    color: #ffffff;
  }

  .scroll-row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 12px;
  }

  /* Split Layout Grid for Desktop & Ultra-Wide */
  .split-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }

  @media (min-width: 1024px) {
    .split-layout {
      grid-template-columns: 1fr 340px;
    }
  }

  @media (min-width: 1440px) {
    .split-layout {
      grid-template-columns: 1fr 380px;
    }
  }

  .trending-spotlight {
    margin-bottom: 20px;
  }

  /* Sleek Compact Horizontal Spotlight Card (Mobile-First) */
  .spotlight-banner-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 115px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 640px) {
    .spotlight-banner-card {
      height: 160px;
      border-radius: var(--radius-lg);
    }
  }

  .spotlight-banner-card:hover {
    border-color: var(--accent-red);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .spotlight-cover-col {
    position: relative;
    width: 88px;
    height: 100%;
    overflow: hidden;
    background-color: var(--bg-elevated);
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .spotlight-cover-col {
      width: 170px;
    }
  }

  .spotlight-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .spotlight-type-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background-color: rgba(0, 0, 0, 0.85);
    color: #ffffff;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .spotlight-info-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 10px 14px;
    flex: 1;
    min-width: 0;
    height: 100%;
    gap: 4px;
  }

  @media (min-width: 640px) {
    .spotlight-info-col {
      padding: 16px 20px;
      gap: 8px;
    }
  }

  .spotlight-top-tags {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rank-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 800;
    color: var(--accent-red);
    background-color: rgba(230, 57, 70, 0.15);
    border: 1px solid var(--accent-red);
    padding: 1px 6px;
    border-radius: var(--radius-full);
  }

  .rating-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--accent-orange);
  }

  .spotlight-title {
    font-family: var(--font-hero);
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 640px) {
    .spotlight-title {
      font-size: 1.2rem;
    }
  }

  .spotlight-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .spotlight-desc {
      font-size: 0.85rem;
      line-height: 1.45;
      -webkit-line-clamp: 2;
    }
  }

  .spotlight-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--border-subtle);
    padding-top: 6px;
    margin-top: auto;
  }

  .spotlight-ch-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .spotlight-cta {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--accent-red);
    letter-spacing: 0.03em;
  }


  .editorial-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .empty-editorial-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 32px 20px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .empty-editorial-box p {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .btn-discover {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-red);
    text-decoration: none;
  }
</style>
