---
import MainLayout from '../layouts/MainLayout.astro';
import HeroBanner from '../components/media/HeroBanner.astro';
import MangaCard from '../components/media/MangaCard.astro';
import AnimeCard from '../components/media/AnimeCard.astro';
import EditorialItem from '../components/media/EditorialItem.astro';
import Badge from '../components/common/Badge.astro';
import { currentUser } from '../db/mockData';

// Zero API requests on dashboard load
const continueReading: any[] = [];
const continueWatching: any[] = [];
const trendingGrid: any[] = [];
const editorialSelections: any[] = [];

const defaultItem = {
  id: 'select-source',
  title: 'SIROCHAN PLATFORM',
  japaneseTitle: 'シロチャン',
  type: 'manga' as const,
  coverImage: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80',
  bannerImage: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=80',
  description: 'Welcome to Sirochan v2. Select a source provider from Discover to start reading manga or watching anime streams.',
  rating: 5.0,
  status: 'RELEASING' as const,
  genres: ['Action', 'Fantasy'],
  latestChapterOrEpisode: 'ONLINE',
  updatedAgo: 'JUST NOW'
};

const heroItem = defaultItem;
const trendingItem = defaultItem;
---

<MainLayout title="Sirochan - Manga & Anime Platform" activeTab="home">
  <!-- Hero Featured Banner -->
  <HeroBanner item={heroItem} />

  <div class="main-content container-constrained">
    <!-- User Greeting Section -->
    <section class="user-greeting-section">
      <h2 class="user-greeting">Good evening, {currentUser.username}</h2>
    </section>

    <!-- Continue Reading Row -->
    {continueReading.length > 0 && (
      <section class="feed-section">
        <div class="section-header-row">
          <div class="header-title-group">
            <h2 class="section-title">CONTINUE READING</h2>
            <span class="section-badge-dot"></span>
          </div>
          <a href="/library" class="view-all-link">VIEW LIBRARY →</a>
        </div>
        <div class="scroll-row hide-scrollbar">
          {continueReading.map((item) => (
            <MangaCard item={item} />
          ))}
        </div>
      </section>
    )}

    <!-- Continue Watching Row -->
    {continueWatching.length > 0 && (
      <section class="feed-section">
        <div class="section-header-row">
          <div class="header-title-group">
            <h2 class="section-title">CONTINUE WATCHING</h2>
            <span class="section-badge-dot orange"></span>
          </div>
          <a href="/library" class="view-all-link">VIEW LIBRARY →</a>
        </div>
        <div class="scroll-row hide-scrollbar">
          {continueWatching.map((item) => (
            <AnimeCard item={item} />
          ))}
        </div>
      </section>
    )}

    <!-- Trending & Editorial Split Layout -->
    <div class="split-layout">
      <!-- Left Column: Trending Section -->
      <section class="feed-section trending-section">
        <div class="section-header-row">
          <div class="header-title-group">
            <h2 class="section-title">TRENDING NOW</h2>
            <Badge variant="red">POPULAR</Badge>
          </div>
        </div>

        {trendingItem && (
          <div class="trending-spotlight">
            <AnimeCard item={trendingItem} />
          </div>
        )}

        {trendingGrid.length > 0 && (
          <div class="trending-grid">
            {trendingGrid.map((item) => (
              item.type === 'manga' ? <MangaCard item={item} /> : <AnimeCard item={item} />
            ))}
          </div>
        )}
      </section>

      <!-- Right Column: Curated Editorials -->
      <section class="feed-section editorial-section">
        <div class="section-header-row">
          <div class="header-title-group">
            <h2 class="section-title">CURATED EDITORIALS</h2>
          </div>
        </div>

        {editorialSelections.length > 0 ? (
          <div class="editorial-stack">
            {editorialSelections.map((item) => (
              <EditorialItem item={item} />
            ))}
          </div>
        ) : (
          <div class="empty-editorial-box">
            <p>Select a provider source to start populating your feed.</p>
            <a href="/discover" class="btn-discover">BROWSE SOURCES →</a>
          </div>
        )}
      </section>
    </div>
  </div>
</MainLayout>

<style>
  .main-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 24px;
    padding-bottom: 40px;
  }

  .user-greeting-section {
    margin-bottom: -8px;
  }

  .user-greeting {
    font-family: var(--font-hero);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .feed-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 10px;
  }

  .header-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-title {
    font-family: var(--font-hero);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #ffffff;
  }

  .section-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--accent-red);
    display: inline-block;
  }

  .section-badge-dot.orange {
    background-color: var(--accent-orange);
  }

  .view-all-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color 0.2s ease;
  }

  .view-all-link:hover {
    color: #ffffff;
  }

  .scroll-row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
  }

  /* Split Layout Grid */
  .split-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 1024px) {
    .split-layout {
      grid-template-columns: 1fr 340px;
    }
  }

  .trending-spotlight {
    margin-bottom: 20px;
  }

  .trending-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media (min-width: 640px) {
    .trending-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .editorial-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .empty-editorial-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 32px 20px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .empty-editorial-box p {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .btn-discover {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-red);
    text-decoration: none;
  }
</style>
