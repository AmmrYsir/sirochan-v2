---
import MainLayout from '../../../layouts/MainLayout.astro';
import MangaReader from '../../../components/reader/MangaReader.astro';
import { ApiService } from '../../../db/apiService';

export async function getStaticPaths() {
  const paths: Array<{ params: { id: string; chapter: string } }> = [];

  try {
    const sources = await ApiService.getSources();
    for (const src of sources) {
      if (src.type === 'manga' || src.type === 'dual') {
        const res = await ApiService.browseSource(src.id);
        for (const item of res.items) {
          const safeId = (item.sourceTitleId || 'title').replace(/[\/\s]/g, '-').toLowerCase();
          paths.push({ params: { id: safeId, chapter: `${safeId}-ch-1` } });
        }
      }
    }
  } catch {
    // fallback
  }

  return paths;
}

const { id, chapter } = Astro.params;

// Resolve real live reader pages from http://localhost:8000 microservice!
let realPagesData = null;

if (id) {
  const sources = await ApiService.getSources();
  for (const src of sources) {
    if (src.type === 'manga' || src.type === 'dual') {
      const readerData = await ApiService.getReaderPages(src.id, id, chapter);
      if (readerData && readerData.pages && readerData.pages.length > 0) {
        realPagesData = readerData;
        break;
      }
    }
  }
}

const item = {
  id: id || 'title',
  title: realPagesData?.title || id?.replace(/-/g, ' ').toUpperCase() || 'MANGA READER',
  type: 'manga' as const
};

const pageUrls = realPagesData && realPagesData.pages.length > 0
  ? realPagesData.pages.map(p => p.imageUrl)
  : [];

const currentChNum = chapter?.includes('ch-') ? parseInt(chapter.split('ch-')[1]) : 1;
---

<MainLayout title={`${item.title} - Manga Reader`} hideNav={true}>
  <MangaReader
    mangaTitle={item.title}
    chapterTitle={`Chapter ${currentChNum}`}
    chapterNumber={currentChNum}
    totalPages={pageUrls.length}
    pages={pageUrls}
    mangaId={item.id}
  />
</MainLayout>
