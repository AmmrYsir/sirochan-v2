---
import MainLayout from '../../../layouts/MainLayout.astro';
import MangaReader from '../../../components/reader/MangaReader.astro';
import { ApiService } from '../../../db/apiService';


const { id, chapter } = Astro.params;

const chNum = chapter?.includes('-ch-') ? chapter.split('-ch-').pop() : (chapter?.includes('ch-') ? chapter.split('ch-').pop() : '1');
const candidates: (string | undefined)[] = Array.from(new Set([
  chapter,
  chNum,
  chNum ? `ch-${chNum}` : undefined,
  chNum ? `chapter-${chNum}` : undefined,
  undefined
]));

let realPagesData: any = null;

if (id) {
  const sources = await ApiService.getSources();
  for (const src of sources) {
    if (src.type === 'manga' || src.type === 'dual') {
      const targetTitleIds = [id];
      const catalog = await ApiService.browseSource(src.id);
      const match = catalog.items.find(item => {
        const safe = (item.sourceTitleId || 'title').replace(/[\/\s]/g, '-').toLowerCase();
        return safe === id || item.sourceTitleId === id || safe.includes(id) || id.includes(safe);
      });

      if (match && match.sourceTitleId && !targetTitleIds.includes(match.sourceTitleId)) {
        targetTitleIds.push(match.sourceTitleId);
      }

      for (const titleId of targetTitleIds) {
        for (const cand of candidates) {
          const res = await ApiService.getReaderPages(src.id, titleId, cand);
          if (res && res.pages && res.pages.length > 0) {
            realPagesData = res;
            break;
          }
        }
        if (realPagesData) break;
      }

      if (realPagesData) break;
    }
  }
}

const item = {
  id: id || 'title',
  title: realPagesData?.title || id?.replace(/-/g, ' ').toUpperCase() || 'MANGA READER',
  type: 'manga' as const
};

const pageUrls = realPagesData && realPagesData.pages.length > 0
  ? realPagesData.pages.map(p => p.imageUrl)
  : [];

const currentChNum = chapter?.includes('ch-') ? parseInt(chapter.split('ch-')[1]) : 1;
---

<MainLayout title={`${item.title} - Manga Reader`} hideNav={true}>
  <MangaReader
    mangaTitle={item.title}
    chapterTitle={`Chapter ${currentChNum}`}
    chapterNumber={currentChNum}
    totalPages={pageUrls.length}
    pages={pageUrls}
    mangaId={item.id}
  />
</MainLayout>
