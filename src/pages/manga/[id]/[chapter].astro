---
import MainLayout from '../../../layouts/MainLayout.astro';
import { mockMediaList } from '../../../db/mockData';

export function getStaticPaths() {
  const mangaList = mockMediaList.filter(m => m.type === 'manga');
  const paths: Array<{ params: { id: string; chapter: string } }> = [];
  
  for (const item of mangaList) {
    const chapters = item.chapters || [
      { id: 'csm-ch-165', mediaId: item.id }
    ];
    for (const ch of chapters) {
      paths.push({ params: { id: item.id, chapter: ch.id } });
    }
  }
  return paths;
}

const { id, chapter } = Astro.params;
const item = mockMediaList.find(m => m.id === id) || mockMediaList[0];

// High quality manga pages for interactive reading demo
const samplePages = [
  'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1200&q=80',
  'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=1200&q=80',
  'https://images.unsplash.com/photo-1563089145-599997674d42?auto=format&fit=crop&w=1200&q=80',
  'https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=1200&q=80'
];
---

<MainLayout title={`${item.title} - Chapter Reader`} hideNav={true}>
  <div class="manga-reader-shell">
    <!-- Top Floating Toolbar -->
    <header class="reader-top-bar">
      <div class="bar-left">
        <a href={`/manga/${item.id}`} class="back-btn" aria-label="Back">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </a>
        <div class="reader-title-info">
          <h1 class="reader-manga-title">{item.title}</h1>
          <span class="reader-ch-subtitle">Chapter 165: The Devil's Mandate</span>
        </div>
      </div>

      <div class="bar-right">
        <select class="chapter-picker">
          <option selected>Ch. 165</option>
          <option>Ch. 164</option>
          <option>Ch. 163</option>
          <option>Ch. 162</option>
        </select>
      </div>
    </header>

    <!-- Manga Pages Canvas (Continuous Vertical View) -->
    <main class="manga-canvas" id="manga-canvas">
      {samplePages.map((pageUrl, idx) => (
        <div class="manga-page-wrapper" id={`page-${idx + 1}`}>
          <img src={pageUrl} alt={`Page ${idx + 1}`} class="manga-page-img" loading="lazy" />
          <span class="page-num-tag">{idx + 1} / {samplePages.length}</span>
        </div>
      ))}
    </main>

    <!-- Bottom Control Bar -->
    <footer class="reader-bottom-bar">
      <div class="bar-container">
        <button class="nav-control-btn" id="prev-page">PREV PAGE</button>
        <span class="page-indicator" id="page-indicator">Page 1 of {samplePages.length}</span>
        <button class="nav-control-btn" id="next-page">NEXT PAGE</button>
      </div>
    </footer>
  </div>
</MainLayout>

<script>
  let currentPage = 1;
  const totalPages = 4;
  const indicator = document.getElementById('page-indicator');

  document.getElementById('prev-page')?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      document.getElementById(`page-${currentPage}`)?.scrollIntoView({ behavior: 'smooth' });
      if (indicator) indicator.textContent = `Page ${currentPage} of ${totalPages}`;
    }
  });

  document.getElementById('next-page')?.addEventListener('click', () => {
    if (currentPage < totalPages) {
      currentPage++;
      document.getElementById(`page-${currentPage}`)?.scrollIntoView({ behavior: 'smooth' });
      if (indicator) indicator.textContent = `Page ${currentPage} of ${totalPages}`;
    }
  });
</script>

<style>
  .manga-reader-shell {
    position: fixed;
    inset: 0;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    z-index: 100;
    overflow: hidden;
  }

  /* Top Bar */
  .reader-top-bar {
    height: 60px;
    background-color: rgba(18, 18, 18, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    z-index: 20;
  }

  .bar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .back-btn {
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
  }

  .back-btn:hover {
    background-color: var(--bg-elevated);
  }

  .reader-manga-title {
    font-family: var(--font-hero);
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
  }

  .reader-ch-subtitle {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: block;
  }

  .chapter-picker {
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: #ffffff;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  /* Canvas */
  .manga-canvas {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px 0 80px 0;
  }

  .manga-page-wrapper {
    position: relative;
    max-width: 900px;
    width: 100%;
    background-color: #121212;
  }

  .manga-page-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .page-num-tag {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background-color: rgba(0, 0, 0, 0.7);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  /* Bottom Bar */
  .reader-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    background-color: rgba(18, 18, 18, 0.95);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
  }

  .bar-container {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-control-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: #ffffff;
    background-color: var(--bg-container-high);
    border: 1px solid var(--border-subtle);
    padding: 6px 16px;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .nav-control-btn:hover {
    background-color: var(--accent-red);
  }

  .page-indicator {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
