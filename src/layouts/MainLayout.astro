---
import Header from '../components/layout/Header.astro';
import NavigationBar from '../components/layout/NavigationBar.astro';
import SidebarNav from '../components/layout/SidebarNav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeTab?: 'home' | 'discover' | 'library' | 'profile';
  hideNav?: boolean;
}

const {
  title = 'Sirochan - Manga Reader & Anime Streaming',
  description = 'Read high quality Manga and stream Anime in one place. Mobile-first Japanese editorial experience.',
  activeTab = 'home',
  hideNav = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <div class={`app-shell ${hideNav ? 'fullscreen-mode' : ''}`}>
      {!hideNav && <SidebarNav activeTab={activeTab} />}
      
      <div class="content-wrapper">
        {!hideNav && <Header />}
        
        <main class={`app-main ${hideNav ? 'no-nav' : ''}`}>
          <slot />
        </main>
      </div>

      {!hideNav && <NavigationBar activeTab={activeTab} />}
    </div>
  </body>
</html>

<style>
  .app-shell {
    display: flex;
    min-height: 100vh;
    background-color: var(--bg-deep);
  }

  .content-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition: margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .app-main {
    flex: 1;
    padding-bottom: 80px;
  }

  .app-main.no-nav {
    padding-bottom: 0;
  }

  @media (min-width: 768px) {
    .content-wrapper {
      margin-left: var(--sidebar-width);
    }
    
    /* Support collapsed sidebar adjustment */
    :global(.sidebar-nav.collapsed) ~ .content-wrapper {
      margin-left: var(--sidebar-collapsed-width);
    }

    .app-main {
      padding-bottom: 40px;
    }
  }
</style>
