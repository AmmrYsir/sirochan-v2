---
import Header from '../components/layout/Header.astro';
import NavigationBar from '../components/layout/NavigationBar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeTab?: 'home' | 'discover' | 'library' | 'profile';
  hideNav?: boolean;
}

const {
  title = 'Sirochan - Unified Manga Reader & Anime Streaming',
  description = 'Read high quality Manga and stream Anime in one place. Mobile-first Japanese editorial experience.',
  activeTab = 'home',
  hideNav = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <div class="app-shell">
      {!hideNav && <Header />}
      
      <main class={`app-main ${hideNav ? 'no-nav' : ''}`}>
        <slot />
      </main>

      {!hideNav && <NavigationBar activeTab={activeTab} />}
    </div>
  </body>
</html>

<style>
  .app-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: var(--bg-deep);
  }

  .app-main {
    flex: 1;
    padding-bottom: 80px;
  }

  .app-main.no-nav {
    padding-bottom: 0;
  }

  @media (min-width: 768px) {
    .app-main {
      padding-bottom: 40px;
    }
  }
</style>
