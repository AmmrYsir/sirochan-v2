---
import ImageViewer from "../common/ImageViewer.astro";
import { MANGA_PLACEHOLDER } from "../../utils/placeholders";

interface Props {
	mangaTitle: string;
	chapterTitle: string;
	chapterNumber: number;
	totalPages: number;
	pages: string[];
	mangaId: string;
	chapters?: Array<{ id: string; number: number; title: string }>;
}

const {
	mangaTitle,
	chapterTitle,
	chapterNumber,
	totalPages,
	pages,
	mangaId,
	chapters = [],
} = Astro.props;
---

<div class="manga-reader-root" id="manga-reader-root">
	<!-- Top Floating Header Bar -->
	<header class="reader-top-bar">
		<div class="bar-left">
			<a
				href="javascript:history.back()"
				class="icon-btn"
				aria-label="Back to Details"
			>
				<svg
					width="22"
					height="22"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
				>
					<polyline points="15 18 9 12 15 6"></polyline>
				</svg>
			</a>
			<div class="manga-meta-group">
				<h1 class="reader-manga-title">{mangaTitle}</h1>
				<span class="reader-ch-subtitle"
					>CH. {chapterNumber} - {chapterTitle}</span
				>
			</div>
		</div>

		<div class="bar-right">
		</div>
	</header>

	<!-- Main Canvas -->
	<main class="reader-canvas mode-continuous" id="reader-canvas">
		{
			pages.map((url, idx) => (
				<div
					class="page-container"
					id={`page-node-${idx + 1}`}
					data-page-idx={idx + 1}
				>
					<img
						src={url}
						alt={`Page ${idx + 1}`}
						class="manga-page-img"
						loading="lazy"
						onerror={`this.onerror=null; this.src='${MANGA_PLACEHOLDER}';`}
					/>
					<div class="page-overlay-tag">
						<span>
							PAGE {idx + 1} / {pages.length}
						</span>
						<button
							class="expand-img-btn"
							data-img-url={url}
							data-page-idx={idx + 1}
						>
							🔍 Expand
						</button>
					</div>
				</div>
			))
		}
	</main>

	<!-- Bottom Floating Toolbar -->
	<footer class="reader-bottom-bar">
		<div class="bottom-bar-inner">
			<button class="nav-step-btn" id="prev-page-btn">PREV</button>

			<div class="slider-group">
				<input
					type="range"
					min="1"
					max={pages.length}
					value="1"
					class="page-slider"
					id="page-slider"
				/>
				<span class="page-counter-text" id="page-counter-display"
					>Page 1 of {pages.length}</span
				>
			</div>

			<button class="nav-step-btn" id="next-page-btn">NEXT</button>
		</div>
	</footer>

	<!-- Lightbox Image Viewer Modal -->
	<ImageViewer />
</div>

<script>
	// Manga Reader Controller Script
	const canvas = document.getElementById("reader-canvas");
	const slider = document.getElementById("page-slider") as HTMLInputElement;
	const counterDisplay = document.getElementById("page-counter-display");
	const modeSelect = document.getElementById(
		"reader-mode-select",
	) as HTMLSelectElement;
	const dirSelect = document.getElementById(
		"reader-dir-select",
	) as HTMLSelectElement;
	const prevBtn = document.getElementById("prev-page-btn");
	const nextBtn = document.getElementById("next-page-btn");
	const expandBtns = document.querySelectorAll(".expand-img-btn");

	let currentPage = 1;
	const totalPages = slider ? parseInt(slider.max) : 1;

	// Sync scroll with page counter
	canvas?.addEventListener("scroll", () => {
		const pageNodes = document.querySelectorAll(".page-container");
		pageNodes.forEach((node, idx) => {
			const rect = node.getBoundingClientRect();
			if (rect.top >= 0 && rect.top <= window.innerHeight / 2) {
				currentPage = idx + 1;
				if (slider) slider.value = currentPage.toString();
				if (counterDisplay)
					counterDisplay.textContent = `Page ${currentPage} of ${totalPages}`;
			}
		});
	});

	// Slider change
	slider?.addEventListener("input", (e) => {
		currentPage = parseInt((e.target as HTMLInputElement).value);
		document
			.getElementById(`page-node-${currentPage}`)
			?.scrollIntoView({ behavior: "smooth" });
		if (counterDisplay)
			counterDisplay.textContent = `Page ${currentPage} of ${totalPages}`;
	});

	// Prev / Next Buttons
	prevBtn?.addEventListener("click", () => {
		if (currentPage > 1) {
			currentPage--;
			document
				.getElementById(`page-node-${currentPage}`)
				?.scrollIntoView({ behavior: "smooth" });
		}
	});

	nextBtn?.addEventListener("click", () => {
		if (currentPage < totalPages) {
			currentPage++;
			document
				.getElementById(`page-node-${currentPage}`)
				?.scrollIntoView({ behavior: "smooth" });
		}
	});

	// View Mode Change (Continuous vs Single Page vs Webtoon)
	modeSelect?.addEventListener("change", (e) => {
		const val = (e.target as HTMLSelectElement).value;
		canvas?.classList.remove(
			"mode-continuous",
			"mode-single",
			"mode-webtoon",
		);
		canvas?.classList.add(`mode-${val}`);
	});

	// Expand Button to trigger ImageViewer Lightbox
	expandBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			const imgUrl = btn.getAttribute("data-img-url") || "";
			const idx = parseInt(btn.getAttribute("data-page-idx") || "1") - 1;
			const allUrls = Array.from(
				document.querySelectorAll(".manga-page-img"),
			).map((img) => (img as HTMLImageElement).src);

			if ((window as any).ImageViewer) {
				(window as any).ImageViewer.open(
					allUrls,
					idx,
					"Manga Page Reader",
				);
			}
		});
	});
</script>

<style>
	.manga-reader-root {
		position: fixed;
		inset: 0;
		background-color: #000000;
		display: flex;
		flex-direction: column;
		z-index: 100;
		overflow: hidden;
	}

	/* Top Bar */
	.reader-top-bar {
		height: 60px;
		background-color: rgba(18, 18, 18, 0.95);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--border-subtle);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 16px;
		z-index: 20;
	}

	.bar-left {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.icon-btn {
		width: 36px;
		height: 36px;
		border-radius: var(--radius-full);
		display: flex;
		align-items: center;
		justify-content: center;
		color: #ffffff;
		transition: background-color 0.2s ease;
	}

	.icon-btn:hover {
		background-color: var(--bg-elevated);
	}

	.reader-manga-title {
		font-family: var(--font-hero);
		font-size: 1rem;
		font-weight: 800;
		color: #ffffff;
	}

	.reader-ch-subtitle {
		font-size: 0.75rem;
		color: var(--text-muted);
		display: block;
	}

	.bar-right {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.chapter-select,
	.mode-select,
	.dir-select {
		background-color: var(--bg-elevated);
		border: 1px solid var(--border-subtle);
		color: #ffffff;
		padding: 6px 12px;
		border-radius: var(--radius-md);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		outline: none;
	}

	/* Canvas */
	.reader-canvas {
		flex: 1;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: 16px 0 80px 0;
	}

	.reader-canvas.mode-webtoon {
		gap: 0;
	}

	.page-container {
		position: relative;
		max-width: 900px;
		width: 100%;
		background-color: #121212;
	}

	.manga-page-img {
		width: 100%;
		height: auto;
		display: block;
	}

	.page-overlay-tag {
		position: absolute;
		bottom: 12px;
		right: 12px;
		background-color: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(4px);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		padding: 4px 10px;
		border-radius: var(--radius-sm);
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.expand-img-btn {
		color: var(--accent-orange);
		font-weight: 700;
		cursor: pointer;
	}

	/* Bottom Control Bar */
	.reader-bottom-bar {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 64px;
		background-color: rgba(18, 18, 18, 0.95);
		backdrop-filter: blur(16px);
		border-top: 1px solid var(--border-subtle);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 20;
		padding: 0 16px;
	}

	.bottom-bar-inner {
		display: flex;
		align-items: center;
		gap: 16px;
		max-width: 600px;
		width: 100%;
	}

	.nav-step-btn {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
		color: #ffffff;
		background-color: var(--bg-elevated);
		border: 1px solid var(--border-subtle);
		padding: 8px 16px;
		border-radius: var(--radius-md);
		cursor: pointer;
	}

	.nav-step-btn:hover {
		background-color: var(--accent-red);
		border-color: var(--accent-red);
	}

	.slider-group {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
	}

	.page-slider {
		width: 100%;
		accent-color: var(--accent-red);
		cursor: pointer;
	}

	.page-counter-text {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-muted);
	}
</style>
