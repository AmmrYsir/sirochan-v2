---
import Button from '../common/Button.astro';
import type { MediaItem } from '../../types';
import { ANIME_PLACEHOLDER } from '../../utils/placeholders';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;
const bannerSrc = item.bannerImage || ANIME_PLACEHOLDER;
---

<section class="hero-banner">
  <div class="hero-bg-wrapper">
    <img
      src={bannerSrc}
      alt={item.title}
      class="hero-bg"
      onerror={`this.onerror=null; this.src='${ANIME_PLACEHOLDER}';`}
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content container-constrained">
    <div class="hero-details">
      <h1 class="hero-title">{item.title}</h1>
      <p class="hero-desc">{item.description}</p>
      
      <div class="hero-actions">
        <Button href={`/${item.sourceId || 'mangadex'}/${item.id}/${item.id}-ch-1`} variant="primary" size="md">
          READ NOW
        </Button>
        <Button href={`/${item.sourceId || 'mangadex'}/${item.id}`} variant="secondary" size="md">
          DETAILS
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    width: 100%;
    min-height: 380px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-bottom: 24px;
  }

  @media (min-width: 768px) {
    .hero-banner {
      min-height: 480px;
      margin-bottom: 40px;
    }
  }

  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.2) 0%,
      rgba(0, 0, 0, 0.6) 50%,
      rgba(0, 0, 0, 0.98) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 10;
    padding-bottom: 32px;
  }

  .hero-details {
    max-width: 600px;
  }

  .hero-title {
    color: #ffffff;
    margin-bottom: 12px;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.8);
  }

  .hero-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
</style>
