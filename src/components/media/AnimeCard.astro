---
import type { MediaItem } from '../../types';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;
const targetHref = `/${item.sourceId || 'hianime'}/${item.id}`;
---

<a href={targetHref} class="anime-card" data-type="anime" data-title={item.title.toLowerCase()} data-genres={item.genres.join(',').toLowerCase()}>
  <div class="card-thumb-container">
    <img src={item.coverImage} alt={item.title} class="card-thumb" loading="lazy" />
    <div class="play-overlay">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
    </div>
    {item.progressPercent !== undefined && (
      <div class="progress-bar-track">
        <div class="progress-bar-fill" style={`width: ${item.progressPercent}%`}></div>
      </div>
    )}
  </div>
  <div class="card-info">
    <h3 class="card-title">{item.title}</h3>
    <p class="card-meta">{item.progressText || `${item.latestChapterOrEpisode}`}</p>
  </div>
</a>

<style>
  .anime-card {
    display: flex;
    flex-direction: column;
    width: 220px;
    flex-shrink: 0;
    text-decoration: none;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 640px) {
    .anime-card {
      width: 260px;
    }
  }

  .anime-card:hover {
    transform: translateY(-4px);
  }

  .anime-card:hover .play-overlay {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }

  .card-thumb-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    margin-bottom: 8px;
  }

  .card-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background-color: rgba(0, 0, 0, 0.7);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .progress-bar-track {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: var(--bg-container-high);
  }

  .progress-bar-fill {
    height: 100%;
    background-color: var(--accent-red);
  }

  .card-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .card-title {
    font-family: var(--font-hero);
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 20px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 16px;
  }
</style>
