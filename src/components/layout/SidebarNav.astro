---
interface Props {
  activeTab?: string;
}

const { activeTab = 'home' } = Astro.props;

const navItems = [
  {
    id: 'home',
    label: 'Home Feed',
    href: '/',
    icon: `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`
  },
  {
    id: 'discover',
    label: 'Discover',
    href: '/discover',
    icon: `<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>`
  },
  {
    id: 'library',
    label: 'My Library',
    href: '/library',
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`
  },
  {
    id: 'profile',
    label: 'Profile & Stats',
    href: '/profile',
    icon: `<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>`
  }
];
---

<aside class="sidebar-nav" id="sidebar-nav">
  <!-- Top Brand Logo -->
  <div class="sidebar-brand">
    <a href="/" class="brand-link">
      <div class="logo-icon">S</div>
      <span class="brand-name">SIROCHAN</span>
    </a>
    <button class="collapse-toggle" id="sidebar-toggle" aria-label="Toggle Sidebar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>
  </div>

  <!-- Primary Navigation Links -->
  <nav class="sidebar-menu">
    <div class="menu-label">MENU</div>
    {navItems.map((item) => {
      const isActive = activeTab === item.id;
      return (
        <a href={item.href} class={`sidebar-item ${isActive ? 'active' : ''}`} title={item.label}>
          <div class="item-icon-wrapper">
            <svg class="item-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={isActive ? "2.2" : "1.8"} stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
          </div>
          <span class="item-label">{item.label}</span>
          {isActive && <span class="active-indicator"></span>}
        </a>
      );
    })}
  </nav>

  <!-- Bottom User Profile Widget -->
  <div class="sidebar-user">
    <a href="/profile" class="user-card" title="View Profile">
      <div class="user-avatar">
        <span>A</span>
      </div>
      <div class="user-info">
        <span class="user-name">Arata</span>
        <span class="user-streak">🔥 3 Day Streak</span>
      </div>
    </a>
  </div>
</aside>

<script>
  const sidebar = document.getElementById('sidebar-nav');
  const toggleBtn = document.getElementById('sidebar-toggle');

  // Load persisted state
  const isCollapsed = localStorage.getItem('sidebar_collapsed') === 'true';
  if (isCollapsed && sidebar) {
    sidebar.classList.add('collapsed');
  }

  toggleBtn?.addEventListener('click', () => {
    if (sidebar) {
      sidebar.classList.toggle('collapsed');
      const collapsedNow = sidebar.classList.contains('collapsed');
      localStorage.setItem('sidebar_collapsed', String(collapsedNow));
    }
  });
</script>

<style>
  /* Hidden on mobile, visible on desktop / tablet */
  .sidebar-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .sidebar-nav {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-width);
      background-color: #0d0d0d;
      border-right: 1px solid var(--border-subtle);
      z-index: 100;
      transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 16px;
      overflow-x: hidden;
    }

    .sidebar-nav.collapsed {
      width: var(--sidebar-collapsed-width);
    }

    .sidebar-nav.collapsed .brand-name,
    .sidebar-nav.collapsed .menu-label,
    .sidebar-nav.collapsed .item-label,
    .sidebar-nav.collapsed .user-info {
      display: none;
    }

    .sidebar-nav.collapsed .collapse-toggle svg {
      transform: rotate(180deg);
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 48px;
      margin-bottom: 24px;
      padding: 0 4px;
    }

    .brand-link {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #ffffff;
    }

    .logo-icon {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, var(--accent-red), #b02a37);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-hero);
      font-weight: 900;
      font-size: 20px;
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(230, 57, 70, 0.3);
      flex-shrink: 0;
    }

    .brand-name {
      font-family: var(--font-hero);
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: -0.01em;
      color: #ffffff;
      white-space: nowrap;
    }

    .collapse-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .collapse-toggle:hover {
      background-color: var(--bg-elevated);
      color: #ffffff;
    }

    .collapse-toggle svg {
      transition: transform 0.25s ease;
    }

    .sidebar-menu {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }

    .menu-label {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--text-dim);
      padding: 8px 12px 4px;
    }

    .sidebar-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border-radius: var(--radius-md);
      color: var(--text-muted);
      font-size: 0.92rem;
      font-weight: 500;
      transition: background-color 0.2s ease, color 0.2s ease;
      position: relative;
      white-space: nowrap;
    }

    .sidebar-item:hover {
      background-color: var(--bg-surface);
      color: #ffffff;
    }

    .sidebar-item.active {
      background-color: var(--bg-elevated);
      color: #ffffff;
      font-weight: 600;
    }

    .item-icon-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .sidebar-item.active .item-icon {
      color: var(--accent-red);
    }

    .active-indicator {
      position: absolute;
      right: 0;
      top: 25%;
      bottom: 25%;
      width: 3px;
      background-color: var(--accent-red);
      border-radius: 2px;
    }

    .sidebar-user {
      border-top: 1px solid var(--border-subtle);
      padding-top: 12px;
      margin-top: auto;
    }

    .user-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px;
      border-radius: var(--radius-md);
      transition: background-color 0.2s ease;
    }

    .user-card:hover {
      background-color: var(--bg-surface);
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-full);
      background-color: var(--bg-container-high);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-hero);
      font-weight: 700;
      color: #ffffff;
      flex-shrink: 0;
    }

    .user-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
      overflow: hidden;
    }

    .user-name {
      font-size: 0.88rem;
      font-weight: 600;
      color: #ffffff;
    }

    .user-streak {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--accent-orange);
    }
  }
</style>
