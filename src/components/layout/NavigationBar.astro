---
interface Props {
  activeTab?: string;
}

const { activeTab = 'home' } = Astro.props;

const navItems = [
  {
    id: 'home',
    label: 'Home',
    href: '/',
    icon: `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`
  },
  {
    id: 'discover',
    label: 'Discover',
    href: '/discover',
    icon: `<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>`
  },
  {
    id: 'library',
    label: 'Library',
    href: '/library',
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`
  },
  {
    id: 'profile',
    label: 'Profile',
    href: '/profile',
    icon: `<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>`
  }
];
---

<nav class="bottom-nav">
  <div class="nav-container container-constrained">
    {navItems.map((item) => {
      const isActive = activeTab === item.id;
      return (
        <a href={item.href} class={`nav-item ${isActive ? 'active' : ''}`}>
          <svg class="nav-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={isActive ? "2.2" : "1.8"} stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
          <span class="nav-label">{item.label}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background-color: rgba(14, 14, 14, 0.95);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--border-subtle);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-around;
    height: 60px;
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: var(--text-muted);
    transition: color 0.2s ease, transform 0.15s ease;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
  }

  .nav-item:hover {
    color: var(--text-primary);
  }

  .nav-item.active {
    color: var(--accent-red);
  }

  .nav-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  /* Hidden on tablet and desktop screens as SidebarNav handles navigation */
  @media (min-width: 768px) {
    .bottom-nav {
      display: none;
    }
  }
</style>
