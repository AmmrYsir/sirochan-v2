---
---

<header class="header">
  <div class="header-inner container-constrained">
    <!-- Brand Logo on Mobile -->
    <a href="/" class="logo mobile-only">
      <span>Sirochan</span>
    </a>

    <!-- Global Desktop Search Bar -->
    <form action="/discover" method="GET" class="header-search-form desktop-only">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" name="q" placeholder="Search manga, anime, creators or genres..." class="header-search-input" />
      <span class="kbd-shortcut">⌘K</span>
    </form>

    <div class="header-actions">
      <!-- Search Button Icon on Mobile -->
      <a href="/discover" class="search-btn mobile-only" aria-label="Search">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <!-- Quick Action Badges / Status on Desktop -->
      <a href="/discover" class="header-action-badge desktop-only">
        <span class="badge-dot green"></span>
        <span>7 Sources Live</span>
      </a>
      <a href="/profile" class="profile-pill desktop-only">
        <div class="pill-avatar">A</div>
        <span class="pill-name">Arata</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(42, 42, 42, 0.4);
    height: 60px;
    display: flex;
    align-items: center;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
  }

  .logo {
    font-family: var(--font-hero);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .desktop-only {
    display: none !important;
  }

  @media (min-width: 768px) {
    .mobile-only {
      display: none !important;
    }
    .desktop-only {
      display: flex !important;
    }
  }

  /* Desktop Quick Search Input Form */
  .header-search-form {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    max-width: 480px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .header-search-input {
    width: 100%;
    height: 38px;
    background-color: #161616;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 0 44px 0 38px;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .header-search-input:focus {
    border-color: var(--accent-red);
    background-color: var(--bg-surface);
  }

  .kbd-shortcut {
    position: absolute;
    right: 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-dim);
    background-color: var(--bg-elevated);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    color: var(--text-primary);
    transition: background-color 0.2s ease;
  }

  .search-btn:hover {
    background-color: var(--bg-elevated);
  }

  .header-action-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .header-action-badge:hover {
    color: #ffffff;
    border-color: var(--text-muted);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
  }

  .badge-dot.green {
    background-color: #2ec4b6;
    box-shadow: 0 0 8px rgba(46, 196, 182, 0.5);
  }

  .profile-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 4px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    transition: background-color 0.2s ease;
  }

  .profile-pill:hover {
    background-color: var(--bg-elevated);
  }

  .pill-avatar {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background-color: var(--accent-red);
    color: #ffffff;
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pill-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ffffff;
  }
</style>
