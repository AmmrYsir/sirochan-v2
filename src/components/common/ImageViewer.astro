---
interface Props {
  id?: string;
}

const { id = 'image-viewer-modal' } = Astro.props;
---

<div class="image-viewer-overlay hidden" id={id}>
  <div class="viewer-top-bar">
    <div class="viewer-info">
      <span class="viewer-title" id="viewer-image-title">Manga Page Illustration</span>
      <span class="viewer-counter" id="viewer-image-counter">Page 1 / 1</span>
    </div>
    
    <div class="viewer-actions">
      <button class="viewer-btn" id="zoom-in-btn" title="Zoom In (+)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
      <button class="viewer-btn" id="zoom-out-btn" title="Zoom Out (-)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
      <button class="viewer-btn" id="zoom-reset-btn" title="Reset Zoom">
        1:1
      </button>
      <button class="viewer-btn close-btn" id="close-viewer-btn" title="Close Viewer (Esc)">
        ✕
      </button>
    </div>
  </div>

  <div class="viewer-stage">
    <button class="nav-arrow prev-arrow" id="viewer-prev-btn" title="Previous Image (←)">
      ‹
    </button>
    
    <div class="image-wrapper" id="viewer-image-container">
      <img src="" alt="Expanded View" id="viewer-active-image" class="viewer-img" />
    </div>

    <button class="nav-arrow next-arrow" id="viewer-next-btn" title="Next Image (→)">
      ›
    </button>
  </div>
</div>

<script>
  // Image Viewer Controller
  class ImageViewerController {
    overlay: HTMLElement | null = null;
    img: HTMLImageElement | null = null;
    container: HTMLElement | null = null;
    scale = 1;
    images: string[] = [];
    currentIndex = 0;

    constructor() {
      this.overlay = document.getElementById('image-viewer-modal');
      this.img = document.getElementById('viewer-active-image') as HTMLImageElement;
      this.container = document.getElementById('viewer-image-container');

      this.initEvents();
    }

    initEvents() {
      document.getElementById('close-viewer-btn')?.addEventListener('click', () => this.close());
      document.getElementById('zoom-in-btn')?.addEventListener('click', () => this.zoom(0.25));
      document.getElementById('zoom-out-btn')?.addEventListener('click', () => this.zoom(-0.25));
      document.getElementById('zoom-reset-btn')?.addEventListener('click', () => this.resetZoom());

      document.getElementById('viewer-prev-btn')?.addEventListener('click', () => this.prev());
      document.getElementById('viewer-next-btn')?.addEventListener('click', () => this.next());

      window.addEventListener('keydown', (e) => {
        if (!this.overlay || this.overlay.classList.contains('hidden')) return;
        if (e.key === 'Escape') this.close();
        if (e.key === 'ArrowLeft') this.prev();
        if (e.key === 'ArrowRight') this.next();
      });
    }

    open(images: string[], index = 0, title = 'Media View') {
      this.images = images;
      this.currentIndex = index;
      this.resetZoom();
      this.updateImage();

      const titleEl = document.getElementById('viewer-image-title');
      if (titleEl) titleEl.textContent = title;

      this.overlay?.classList.remove('hidden');
    }

    close() {
      this.overlay?.classList.add('hidden');
    }

    zoom(delta: number) {
      this.scale = Math.max(0.5, Math.min(3, this.scale + delta));
      if (this.img) this.img.style.transform = `scale(${this.scale})`;
    }

    resetZoom() {
      this.scale = 1;
      if (this.img) this.img.style.transform = 'scale(1)';
    }

    updateImage() {
      if (this.img && this.images[this.currentIndex]) {
        this.img.src = this.images[this.currentIndex];
      }
      const counterEl = document.getElementById('viewer-image-counter');
      if (counterEl) counterEl.textContent = `Page ${this.currentIndex + 1} / ${this.images.length}`;
    }

    prev() {
      if (this.currentIndex > 0) {
        this.currentIndex--;
        this.resetZoom();
        this.updateImage();
      }
    }

    next() {
      if (this.currentIndex < this.images.length - 1) {
        this.currentIndex++;
        this.resetZoom();
        this.updateImage();
      }
    }
  }

  // Global window hook for opening viewer
  (window as any).ImageViewer = new ImageViewerController();
</script>

<style>
  .image-viewer-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background-color: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(16px);
    display: flex;
    flex-direction: column;
  }

  .image-viewer-overlay.hidden {
    display: none;
  }

  .viewer-top-bar {
    height: 60px;
    padding: 0 20px;
    background-color: rgba(18, 18, 18, 0.9);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .viewer-info {
    display: flex;
    flex-direction: column;
  }

  .viewer-title {
    font-family: var(--font-hero);
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
  }

  .viewer-counter {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .viewer-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .viewer-btn {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .viewer-btn:hover {
    background-color: var(--accent-red);
    border-color: var(--accent-red);
  }

  .viewer-btn.close-btn {
    background-color: var(--accent-red);
  }

  .viewer-stage {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    overflow: hidden;
  }

  .nav-arrow {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background-color: rgba(30, 30, 30, 0.8);
    border: 1px solid var(--border-subtle);
    color: #ffffff;
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s ease;
  }

  .nav-arrow:hover {
    background-color: var(--accent-red);
  }

  .image-wrapper {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: auto;
  }

  .viewer-img {
    max-width: 90%;
    max-height: 90vh;
    object-fit: contain;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.8);
  }
</style>
