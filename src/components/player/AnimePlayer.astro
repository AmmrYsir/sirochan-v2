---
interface Props {
  animeTitle: string;
  episodeNumber: number;
  seasonNumber?: number;
  episodeTitle: string;
  videoUrl: string;
  posterUrl: string;
  animeId: string;
  episodes?: Array<{ id: string; number: number; title: string; duration: string }>;
}

const {
  animeTitle,
  episodeNumber,
  seasonNumber = 1,
  episodeTitle,
  videoUrl,
  posterUrl,
  animeId,
  episodes = []
} = Astro.props;

// Determine if videoUrl is an embed link (e.g. iframe embed, embedframe, /post/, or non-direct media file)
const isEmbedUrl = !videoUrl || 
                   videoUrl.includes('/embed') || 
                   videoUrl.includes('embedframe') || 
                   videoUrl.includes('iframe') || 
                   videoUrl.includes('/post/') || 
                   !videoUrl.match(/\.(mp4|m3u8|webm|ogg|mov)(\?.*)?$/i);
---

<div class="anime-player-root" id="anime-player-root" data-anime-id={animeId} data-anime-title={animeTitle} data-episode-number={episodeNumber}>
  <!-- Minimal Header Bar -->
  <header class="player-header">
    <div class="header-left">
      <a href="javascript:history.back()" class="icon-btn" aria-label="Back">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </a>
      <div class="anime-title-group">
        <h1 class="anime-main-title">{animeTitle}</h1>
        <span class="anime-ep-sub">EP. {episodeNumber} • {episodeTitle}</span>
      </div>
    </div>

    <div class="header-right">
      <span class="quality-badge">{isEmbedUrl ? 'EMBED STREAM' : '1080p HD'}</span>
    </div>
  </header>

  <!-- Video Stage Container -->
  <div class="video-stage" id="video-stage">
    {isEmbedUrl ? (
      <iframe
        id="player-iframe"
        class="video-element video-iframe"
        src={videoUrl}
        allowfullscreen
        allow="autoplay; encrypted-media; picture-in-picture; accelerometer; gyroscope"
        style="width: 100%; height: 100%; border: none; background: #000;"
      >
      </iframe>
    ) : (
      <>
        <!-- Clean Video Element (No Native Controls) -->
        <video
          id="player-video"
          class="video-element"
          poster={posterUrl}
          src={videoUrl}
          playsinline
          {...{ referrerpolicy: "no-referrer" }}
        >
        </video>

        <!-- Big Center Play Button Overlay -->
        <button class="big-center-play" id="big-play-btn" aria-label="Toggle Play">
          <svg class="big-play-icon" width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="6 3 20 12 6 21 6 3"></polygon>
          </svg>
        </button>

        <!-- Custom Player Overlay Controls -->
        <div class="player-controls-overlay" id="controls-overlay">
          <!-- Seeker Bar -->
          <div class="seeker-wrapper">
            <div class="seeker-track" id="seeker-track">
              <div class="seeker-fill" id="seeker-fill" style="width: 0%;"></div>
              <div class="seeker-thumb" id="seeker-thumb" style="left: 0%;"></div>
            </div>
            <input type="range" min="0" max="100" value="0" step="0.1" class="seeker-input" id="seeker-input" />
          </div>

          <!-- Control Buttons Row -->
          <div class="controls-row">
            <div class="row-left">
              <button class="ctrl-btn play-btn" id="play-btn" title="Play/Pause (Space)">
                <svg class="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <svg class="icon-pause hidden" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <rect x="6" y="4" width="4" height="16"></rect>
                  <rect x="14" y="4" width="4" height="16"></rect>
                </svg>
              </button>

              <button class="ctrl-btn" id="rewind-btn" title="Rewind 10s (Left Arrow)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M11 19l-9-7 9-7v14zM22 19l-9-7 9-7v14z"></path>
                </svg>
              </button>

              <button class="ctrl-btn" id="forward-btn" title="Forward 10s (Right Arrow)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M13 5l9 7-9 7V5zM2 5l9 7-9 7V5z"></path>
                </svg>
              </button>

              <div class="volume-group">
                <button class="ctrl-btn" id="mute-btn" title="Mute (M)">
                  <svg class="icon-vol-high" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                  <svg class="icon-vol-mute hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="1" y1="1" x2="23" y2="23"></line><path d="M9 9l3 3v7l-5-4H3V9h3.58"></path></svg>
                </button>
                <input type="range" min="0" max="1" step="0.05" value="1" class="volume-slider" id="volume-slider" />
              </div>

              <span class="time-readout" id="time-display">00:00 / 00:00</span>
            </div>

            <div class="row-right">
              <button class="ctrl-btn" id="fullscreen-btn" title="Fullscreen (F)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </>
    )}
  </div>

  {episodes.length > 1 && (
    <div class="episodes-navigation container-constrained">
      <h3 class="section-title">OTHER EPISODES</h3>
      <div class="episodes-scroll-row hide-scrollbar">
        {episodes.map(ep => {
          const isCurrent = ep.number === episodeNumber;
          return (
            <a href={`?ep=${ep.number}`} class={`ep-item-card ${isCurrent ? 'active' : ''}`}>
              <span class="ep-badge">EP. {ep.number}</span>
              <span class="ep-title">{ep.title}</span>
            </a>
          );
        })}
      </div>
    </div>
  )}
</div>

<script>
  const stage = document.getElementById('video-stage') as HTMLElement;
  const video = document.getElementById('player-video') as HTMLVideoElement;
  const bigPlayBtn = document.getElementById('big-play-btn') as HTMLElement;
  const playBtn = document.getElementById('play-btn') as HTMLElement;
  const iconPlay = playBtn?.querySelector('.icon-play');
  const iconPause = playBtn?.querySelector('.icon-pause');
  
  const rewindBtn = document.getElementById('rewind-btn');
  const forwardBtn = document.getElementById('forward-btn');
  
  const seekerInput = document.getElementById('seeker-input') as HTMLInputElement;
  const seekerFill = document.getElementById('seeker-fill');
  const seekerThumb = document.getElementById('seeker-thumb');
  const timeDisplay = document.getElementById('time-display');
  
  const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
  const muteBtn = document.getElementById('mute-btn');
  const iconVolHigh = muteBtn?.querySelector('.icon-vol-high');
  const iconVolMute = muteBtn?.querySelector('.icon-vol-mute');
  const fullscreenBtn = document.getElementById('fullscreen-btn');

  let hideTimer: any = null;

  function togglePlay() {
    if (!video) return;
    if (video.paused) {
      video.play().catch(() => {});
    } else {
      video.pause();
    }
  }

  function updatePlayUI() {
    if (!video) return;
    if (video.paused) {
      iconPlay?.classList.remove('hidden');
      iconPause?.classList.add('hidden');
      bigPlayBtn?.classList.remove('hidden');
    } else {
      iconPlay?.classList.add('hidden');
      iconPause?.classList.remove('hidden');
      bigPlayBtn?.classList.add('hidden');
    }
  }

  function formatTime(sec: number): string {
    if (isNaN(sec) || sec < 0) return '00:00';
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  }

  function resetHideTimer() {
    if (!stage || !video) return;
    stage.classList.remove('user-inactive');
    clearTimeout(hideTimer);
    if (!video.paused) {
      hideTimer = setTimeout(() => {
        stage.classList.add('user-inactive');
      }, 2500);
    }
  }

  if (video) {
    video.addEventListener('click', togglePlay);
    bigPlayBtn?.addEventListener('click', togglePlay);
    playBtn?.addEventListener('click', togglePlay);

    video.addEventListener('play', updatePlayUI);
    video.addEventListener('pause', updatePlayUI);

    let lastSyncTime = 0;
    video.addEventListener('timeupdate', () => {
      if (video.duration) {
        const pct = (video.currentTime / video.duration) * 100;
        if (seekerInput) seekerInput.value = pct.toString();
        if (seekerFill) seekerFill.style.width = `${pct}%`;
        if (seekerThumb) seekerThumb.style.left = `${pct}%`;
        if (timeDisplay) timeDisplay.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;

        // Sync to DB every 10 seconds
        if (Math.abs(video.currentTime - lastSyncTime) > 10) {
          lastSyncTime = video.currentTime;
          const root = document.getElementById('anime-player-root');
          const aId = root?.getAttribute('data-anime-id') || 'anime';
          const aTitle = root?.getAttribute('data-anime-title') || 'Anime';
          const epNum = parseInt(root?.getAttribute('data-episode-number') || '1');

          fetch('/api/progress/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              mediaId: aId.includes(':') ? aId : `spankbang:${aId}`,
              sourceId: aId.includes(':') ? aId.split(':')[0] : 'spankbang',
              sourceTitleId: aId.includes(':') ? aId.split(':')[1] : aId,
              title: aTitle,
              type: 'anime',
              contentType: 'episode',
              contentId: `ep-${epNum}`,
              contentNumber: epNum,
              timeMarkerSeconds: Math.floor(video.currentTime),
              progressPercent: Math.min(100, Math.round(pct))
            })
          }).catch(() => {});
        }
      }
    });

    seekerInput?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (video.duration) {
        video.currentTime = (val / 100) * video.duration;
      }
    });

    rewindBtn?.addEventListener('click', () => {
      video.currentTime = Math.max(0, video.currentTime - 10);
    });

    forwardBtn?.addEventListener('click', () => {
      if (video.duration) {
        video.currentTime = Math.min(video.duration, video.currentTime + 10);
      }
    });

    volumeSlider?.addEventListener('input', (e) => {
      video.volume = parseFloat((e.target as HTMLInputElement).value);
      video.muted = video.volume === 0;
      if (video.muted) {
        iconVolHigh?.classList.add('hidden');
        iconVolMute?.classList.remove('hidden');
      } else {
        iconVolHigh?.classList.remove('hidden');
        iconVolMute?.classList.add('hidden');
      }
    });

    muteBtn?.addEventListener('click', () => {
      video.muted = !video.muted;
      if (video.muted) {
        iconVolHigh?.classList.add('hidden');
        iconVolMute?.classList.remove('hidden');
      } else {
        iconVolHigh?.classList.remove('hidden');
        iconVolMute?.classList.add('hidden');
      }
    });

    fullscreenBtn?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        stage.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    // Mouse movement auto-hide controls
    stage?.addEventListener('mousemove', resetHideTimer);
    stage?.addEventListener('mouseleave', () => {
      if (!video.paused) stage.classList.add('user-inactive');
    });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      if (['input', 'textarea', 'select'].includes((e.target as HTMLElement).tagName.toLowerCase())) return;
      if (e.key === ' ' || e.key === 'k' || e.key === 'K') {
        e.preventDefault();
        togglePlay();
      } else if (e.key === 'f' || e.key === 'F') {
        e.preventDefault();
        if (!document.fullscreenElement) {
          stage.requestFullscreen().catch(() => {});
        } else {
          document.exitFullscreen().catch(() => {});
        }
      } else if (e.key === 'm' || e.key === 'M') {
        e.preventDefault();
        video.muted = !video.muted;
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        video.currentTime = Math.max(0, video.currentTime - 10);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        if (video.duration) video.currentTime = Math.min(video.duration, video.currentTime + 10);
      }
    });
  } else {
    // For iframe player, allow fullscreen button handling if available
    fullscreenBtn?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        stage.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });
  }
</script>

<style>
  .anime-player-root {
    position: fixed;
    inset: 0;
    background-color: #09090b;
    display: flex;
    flex-direction: column;
    z-index: 100;
    overflow-y: auto;
  }

  /* Header Bar */
  .player-header {
    height: 56px;
    padding: 0 20px;
    background-color: rgba(12, 12, 15, 0.95);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 20;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .icon-btn {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    transition: all 0.2s ease;
  }

  .icon-btn:hover {
    background-color: var(--bg-elevated);
    border-color: var(--text-muted);
  }

  .anime-main-title {
    font-family: var(--font-hero);
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
  }

  .anime-ep-sub {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .quality-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-red);
    background-color: rgba(230, 57, 70, 0.12);
    border: 1px solid rgba(230, 57, 70, 0.3);
    border-radius: var(--radius-full);
    padding: 4px 10px;
  }

  /* Video Stage */
  .video-stage {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    background-color: #000000;
    overflow: hidden;
    cursor: pointer;
  }

  .video-element {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Big Center Play Button Overlay */
  .big-center-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    background-color: rgba(230, 57, 70, 0.85);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 0 30px rgba(230, 57, 70, 0.5);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .big-center-play:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background-color: var(--accent-red);
  }

  /* Controls Overlay */
  .player-controls-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.4) 60%, rgba(0, 0, 0, 0) 100%);
    padding: 12px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 15;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .video-stage.user-inactive .player-controls-overlay {
    opacity: 0;
    visibility: hidden;
  }

  /* Seeker Bar */
  .seeker-wrapper {
    position: relative;
    width: 100%;
    height: 14px;
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .seeker-track {
    position: absolute;
    left: 0;
    right: 0;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    pointer-events: none;
    transition: height 0.15s ease;
  }

  .seeker-wrapper:hover .seeker-track {
    height: 6px;
  }

  .seeker-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-red) 0%, var(--accent-orange) 100%);
    border-radius: var(--radius-full);
    pointer-events: none;
  }

  .seeker-thumb {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    background-color: #ffffff;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .seeker-wrapper:hover .seeker-thumb {
    opacity: 1;
  }

  .seeker-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  /* Controls Buttons Row */
  .controls-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .row-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .ctrl-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 4px;
    border-radius: var(--radius-sm);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .ctrl-btn:hover {
    color: var(--accent-red);
    transform: scale(1.1);
  }

  .volume-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .volume-slider {
    width: 65px;
    height: 4px;
    accent-color: var(--accent-red);
    cursor: pointer;
  }

  .time-readout {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .row-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hidden {
    display: none !important;
  }

  /* Episodes Section */
  .episodes-navigation {
    padding-top: 20px;
    padding-bottom: 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .episodes-scroll-row {
    display: flex;
    gap: 10px;
    overflow-x: auto;
  }

  .ep-item-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    min-width: 120px;
    transition: all 0.2s ease;
  }

  .ep-item-card.active, .ep-item-card:hover {
    border-color: var(--accent-red);
    background-color: var(--bg-elevated);
  }

  .ep-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-red);
  }

  .ep-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
