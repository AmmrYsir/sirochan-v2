---
interface Props {
  animeTitle: string;
  episodeNumber: number;
  seasonNumber?: number;
  episodeTitle: string;
  videoUrl: string;
  posterUrl: string;
  animeId: string;
  episodes?: Array<{ id: string; number: number; title: string; duration: string }>;
}

const {
  animeTitle,
  episodeNumber,
  seasonNumber = 1,
  episodeTitle,
  videoUrl,
  posterUrl,
  animeId,
  episodes = Array.from({ length: 12 }, (_, i) => ({
    id: `sl-ep-${i + 1}`,
    number: i + 1,
    title: `Episode ${i + 1}: The Unfolding Destiny`,
    duration: '23:10'
  }))
} = Astro.props;
---

<div class="anime-player-root">
  <!-- Header Bar -->
  <header class="player-header">
    <div class="header-left">
      <a href="javascript:history.back()" class="icon-btn" aria-label="Back to Anime Details">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </a>
      <div class="anime-title-group">
        <h1 class="anime-main-title">{animeTitle}</h1>
        <span class="anime-ep-sub">S{seasonNumber} EP.{episodeNumber} • {episodeTitle}</span>
      </div>
    </div>

    <div class="header-right">
      <select class="player-select" id="quality-select">
        <option value="1080p" selected>1080p Full HD</option>
        <option value="720p">720p HD</option>
        <option value="480p">480p SD</option>
        <option value="auto">Auto Adaptive</option>
      </select>

      <select class="player-select" id="subtitle-select">
        <option value="en" selected>Subtitles: English</option>
        <option value="jp">Subtitles: Japanese</option>
        <option value="off">Subtitles: Off</option>
      </select>
    </div>
  </header>

  <!-- Video Stage Container -->
  <div class="video-stage">
    <video id="player-video" class="video-element" poster={posterUrl} src={videoUrl}>
      <track kind="captions" src="" srclang="en" label="English" default />
    </video>

    <!-- Skip Intro Overlay Pill -->
    <button class="skip-pill-btn skip-intro" id="skip-intro-btn">
      SKIP INTRO (+85s) ⚡
    </button>
    <button class="skip-pill-btn skip-outro" id="skip-outro-btn">
      SKIP OUTRO (+90s) ⚡
    </button>

    <!-- Custom Player Overlay Controls -->
    <div class="player-controls-overlay">
      <!-- Seeker Bar -->
      <div class="seeker-container">
        <input type="range" min="0" max="100" value="0" class="seeker-bar" id="seeker-bar" />
        <div class="seeker-fill" id="seeker-fill" style="width: 0%;"></div>
      </div>

      <!-- Control Buttons Row -->
      <div class="controls-row">
        <div class="row-left">
          <button class="ctrl-btn play-btn" id="play-btn" title="Play/Pause (Space)">
            <svg class="play-icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </button>

          <button class="ctrl-btn" id="rewind-btn" title="Rewind 10s (←)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 19l-9-7 9-7v14zM22 19l-9-7 9-7v14z"></path>
            </svg>
          </button>

          <button class="ctrl-btn" id="forward-btn" title="Forward 10s (→)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 5l9 7-9 7V5zM2 5l9 7-9 7V5z"></path>
            </svg>
          </button>

          <div class="volume-group">
            <button class="ctrl-btn" id="mute-btn" title="Mute/Unmute">
              🔊
            </button>
            <input type="range" min="0" max="1" step="0.05" value="1" class="volume-slider" id="volume-slider" />
          </div>

          <span class="time-readout" id="time-display">00:00 / 23:10</span>
        </div>

        <div class="row-right">
          <button class="ctrl-btn" id="fullscreen-btn" title="Fullscreen (F)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Episode Sidebar Navigation -->
  <div class="episodes-navigation container-constrained">
    <h3 class="section-title">EPISODE SELECTION</h3>
    <div class="episodes-scroll-row hide-scrollbar">
      {episodes.map(ep => {
        const isCurrent = ep.number === episodeNumber;
        return (
          <a href={`?ep=${ep.number}`} class={`ep-item-card ${isCurrent ? 'active' : ''}`}>
            <span class="ep-badge">EP. {ep.number}</span>
            <span class="ep-title">{ep.title}</span>
            <span class="ep-dur">{ep.duration}</span>
          </a>
        );
      })}
    </div>
  </div>
</div>

<script>
  // Video Player Controller Script
  const video = document.getElementById('player-video') as HTMLVideoElement;
  const playBtn = document.getElementById('play-btn');
  const rewindBtn = document.getElementById('rewind-btn');
  const forwardBtn = document.getElementById('forward-btn');
  const skipIntroBtn = document.getElementById('skip-intro-btn');
  const skipOutroBtn = document.getElementById('skip-outro-btn');
  const seekerBar = document.getElementById('seeker-bar') as HTMLInputElement;
  const seekerFill = document.getElementById('seeker-fill');
  const timeDisplay = document.getElementById('time-display');
  const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
  const muteBtn = document.getElementById('mute-btn');
  const fullscreenBtn = document.getElementById('fullscreen-btn');

  if (video) {
    // Play/Pause
    playBtn?.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        if (playBtn) playBtn.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>`;
      } else {
        video.pause();
        if (playBtn) playBtn.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
      }
    });

    // Time update & Seeker
    video.addEventListener('timeupdate', () => {
      if (video.duration) {
        const pct = (video.currentTime / video.duration) * 100;
        if (seekerBar) seekerBar.value = pct.toString();
        if (seekerFill) seekerFill.style.width = `${pct}%`;

        const curM = Math.floor(video.currentTime / 60);
        const curS = Math.floor(video.currentTime % 60).toString().padStart(2, '0');
        const durM = Math.floor(video.duration / 60);
        const durS = Math.floor(video.duration % 60).toString().padStart(2, '0');
        if (timeDisplay) timeDisplay.textContent = `${curM}:${curS} / ${durM}:${durS}`;
      }
    });

    seekerBar?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      if (video.duration) {
        video.currentTime = (val / 100) * video.duration;
      }
    });

    // Rewind / Forward 10s
    rewindBtn?.addEventListener('click', () => video.currentTime = Math.max(0, video.currentTime - 10));
    forwardBtn?.addEventListener('click', () => video.currentTime = Math.min(video.duration, video.currentTime + 10));

    // Skip Intro / Outro
    skipIntroBtn?.addEventListener('click', () => video.currentTime += 85);
    skipOutroBtn?.addEventListener('click', () => video.currentTime += 90);

    // Volume & Mute
    volumeSlider?.addEventListener('input', (e) => {
      video.volume = parseFloat((e.target as HTMLInputElement).value);
    });

    muteBtn?.addEventListener('click', () => {
      video.muted = !video.muted;
      if (muteBtn) muteBtn.textContent = video.muted ? '🔇' : '🔊';
    });

    // Fullscreen
    fullscreenBtn?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        video.parentElement?.requestFullscreen();
      } else {
        document.exitFullscreen();
      }
    });
  }
</script>

<style>
  .anime-player-root {
    position: fixed;
    inset: 0;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    z-index: 100;
    overflow-y: auto;
  }

  /* Header Bar */
  .player-header {
    height: 60px;
    padding: 0 16px;
    background-color: rgba(18, 18, 18, 0.95);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 20;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .icon-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .anime-main-title {
    font-family: var(--font-hero);
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
  }

  .anime-ep-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .player-select {
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: #ffffff;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    outline: none;
  }

  /* Video Stage */
  .video-stage {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    background-color: #000000;
  }

  .video-element {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Skip Overlay Pills */
  .skip-pill-btn {
    position: absolute;
    bottom: 75px;
    background-color: rgba(30, 30, 30, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-subtle);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 15;
  }

  .skip-pill-btn:hover {
    background-color: var(--accent-red);
    border-color: var(--accent-red);
  }

  .skip-intro {
    right: 20px;
  }

  .skip-outro {
    right: 170px;
  }

  /* Controls Overlay */
  .player-controls-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0) 100%);
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 10;
  }

  .seeker-container {
    position: relative;
    width: 100%;
    height: 6px;
  }

  .seeker-bar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .seeker-fill {
    height: 100%;
    background-color: var(--accent-orange);
    border-radius: var(--radius-full);
    pointer-events: none;
  }

  .controls-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .row-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ctrl-btn {
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .volume-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .volume-slider {
    width: 70px;
    accent-color: var(--accent-red);
  }

  .time-readout {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Episode Navigation */
  .episodes-navigation {
    padding-top: 24px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .episodes-scroll-row {
    display: flex;
    gap: 12px;
    overflow-x: auto;
  }

  .ep-item-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    min-width: 140px;
    transition: all 0.2s ease;
  }

  .ep-item-card.active {
    border-color: var(--accent-red);
    background-color: var(--bg-elevated);
  }

  .ep-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-red);
  }

  .ep-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .ep-dur {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }
</style>
