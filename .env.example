# ==============================================================================
# Sirochan v2 — Environment Variables Configuration Template (.env.example)
# Copy this file to '.env' and adjust environment variables for your local setup.
# ==============================================================================

# App & Runtime Environment
NODE_ENV=development
APP_PORT=4321

# Database Credentials & Port Configuration
POSTGRES_USER=sirochan
POSTGRES_PASSWORD=sirochan_secret
POSTGRES_DB=sirochan_db
DB_PORT=5432

# Host Database Connection String
DATABASE_URL=postgresql://sirochan:sirochan_secret@localhost:5432/sirochan_db

# Microservices Architecture Endpoints
LOOUWD_URL=http://localhost:8000
AUTH_URL=http://localhost:3000
